---
/**
 * Section heading: a mono "// kicker", the h2, an optional subtitle and an optional
 * action (slot "action", e.g. a "View all" button) aligned to the right.
 */
import Icon, { type IconName } from './ui/Icon.astro';

interface Props {
  id: string;
  kicker?: string;
  icon?: IconName;
  sub?: string;
}
const { id, kicker, icon, sub } = Astro.props;
---

<div class="section-head">
  <div>
    {
      kicker && (
        <p class="kicker">
          {icon && <Icon name={icon} size={15} />}
          {kicker}
        </p>
      )
    }
    <h2 id={id}><slot /></h2>
    {sub && <p class="sub">{sub}</p>}
  </div>
  <slot name="action" />
</div>
