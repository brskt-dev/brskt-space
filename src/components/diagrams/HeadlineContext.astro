---
/**
 * Article "contexto-da-manchete": two ILLUSTRATIVE headlines built from real IBGE
 * numbers (one flattering, one unflattering), the complementary context each one
 * leaves out, and what that context does to the meaning: adjust or invert.
 * Every number here is from IBGE (PNAD Contínua tables 6381/6318, PME table 2176).
 */
import DiagramFrame from './DiagramFrame.astro';
import Icon from '../ui/Icon.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pt = lang === 'pt';

const title = pt ? 'Duas manchetes, o mesmo IBGE' : 'Two headlines, the same IBGE data';
const caption = pt
  ? 'Manchetes montadas por mim com números reais do IBGE (PNAD Contínua e PME), consultados em 8/10/2026. Nenhuma foi tirada de um veículo.'
  : 'Headlines I wrote using real IBGE numbers (PNAD Contínua and PME), checked on 8 Oct 2026. Neither comes from a news outlet.';
const missing = pt ? 'o contexto que ficou de fora' : 'the context left out';
const scaleWords = pt ? ['confirma', 'ajusta', 'inverte'] : ['confirms', 'adjusts', 'inverts'];

const cards = [
  {
    key: 'a',
    label: pt ? 'manchete A · tom otimista' : 'headline A · upbeat',
    headline: pt ? 'Desemprego cai para 5,3%, o menor da história' : 'Unemployment falls to 5.3%, the lowest ever',
    items: [
      { tag: pt ? 'série' : 'series', text: pt ? '“Da história” quer dizer desde 2012, quando começa a PNAD Contínua' : '“Ever” means since 2012, when the PNAD Contínua series starts' },
      { tag: pt ? 'recorde' : 'record', text: pt ? 'O mínimo da série foi 5,1%, em out–dez de 2025' : 'The series low was 5.1%, in Oct–Dec 2025' },
      { tag: pt ? 'mesmo trimestre' : 'same quarter', text: pt ? 'Jun–ago de 2025: 5,6%. A queda é real' : 'Jun–Aug 2025: 5.6%. The fall is real' },
      { tag: pt ? 'composição' : 'breakdown', text: pt ? '+1,06 milhão de pessoas ocupadas em um ano' : '+1.06 million people employed in a year' },
    ],
    verdict: pt ? 'confirma a queda e corrige o recorde' : 'confirms the fall and corrects the record',
    level: 1,
  },
  {
    key: 'b',
    label: pt ? 'manchete B · tom pessimista' : 'headline B · gloomy',
    headline: pt ? 'Em 2014 o desemprego era 4,3%; hoje é 5,3%' : 'In 2014 unemployment was 4.3%; today it is 5.3%',
    items: [
      { tag: pt ? 'método' : 'method', text: pt ? '4,3% é da PME: seis regiões metropolitanas, encerrada em 2016' : '4.3% is from the PME: six metro areas, discontinued in 2016' },
      { tag: pt ? 'recorte' : 'cherry-pick', text: pt ? 'Foi o menor valor da pesquisa antiga (dez. de 2013 e de 2014)' : 'It was the old survey’s lowest value (Dec 2013 and 2014)' },
      { tag: pt ? 'fonte' : 'source', text: pt ? 'O IBGE diz que as duas pesquisas não são comparáveis' : 'IBGE says the two surveys are not comparable' },
      { tag: pt ? 'mesma pesquisa' : 'same survey', text: pt ? 'Na PNAD Contínua, 2014 teve 7,0% (jun–ago) e 6,6% (out–dez)' : 'In the PNAD Contínua, 2014 had 7.0% (Jun–Aug) and 6.6% (Oct–Dec)' },
    ],
    verdict: pt ? 'na mesma pesquisa, o desemprego de hoje é menor' : 'in the same survey, unemployment is lower today',
    level: 2,
  },
];
---

<DiagramFrame lang={lang} id="dg-headlines" title={title} status="illustrative" caption={caption}>
  <div class="hc">
    {
      cards.map((c) => (
        <div class={`card card-${c.key}`}>
          <p class="label">{c.label}</p>
          <p class="headline">
            <Icon name="newspaper" size={16} />
            <span>{c.headline}</span>
          </p>
          <p class="k">
            <Icon name="scan-text" size={13} />
            {missing}
          </p>
          <ol class="items">
            {c.items.map((it, i) => (
              <li style={`--i:${i}`}>
                <span class="tag">{it.tag}</span>
                <span>{it.text}</span>
              </li>
            ))}
          </ol>
          <div class="verdict">
            <ol class="scale" aria-hidden="true">
              {scaleWords.map((w, i) => (
                <li class:list={{ on: i === c.level }}>{w}</li>
              ))}
            </ol>
            <p class="v-text">
              <Icon name="circle-check" size={14} />
              {c.verdict}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</DiagramFrame>

<style>
  .hc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
  }

  @media (min-width: 46rem) {
    .hc {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: 0.9rem;
    border: 1px solid var(--border-hi);
    border-radius: var(--r);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
  }

  .label {
    margin: 0;
    font: 500 0.68rem / 1.2 var(--font-mono);
    color: var(--accent);
  }

  /* the headline as it arrives in a chat */
  .headline {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin: 0;
    padding: 0.65rem 0.75rem;
    border-radius: 12px 12px 12px 4px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font: 700 0.98rem / 1.25 var(--font-display);
  }

  .headline :global(.icon) {
    flex: none;
    margin-top: 0.15rem;
    color: var(--muted);
  }

  .k {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0.2rem 0 0;
    font: 500 0.66rem / 1 var(--font-mono);
    color: var(--mint);
  }

  .items {
    list-style: none;
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .items li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.45rem;
    margin: 0;
    padding: 0.45rem 0.55rem;
    border-left: 2px solid color-mix(in srgb, var(--mint) 55%, transparent);
    border-radius: 0 8px 8px 0;
    background: color-mix(in srgb, var(--bg-2) 85%, transparent);
    font-size: 0.8rem;
    line-height: 1.4;
    animation: lit 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 1.4s);
  }

  .tag {
    padding: 0.02rem 0.42rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    font: 600 0.6rem / 1.45 var(--font-mono);
    color: var(--accent);
    white-space: nowrap;
  }

  .verdict {
    display: grid;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-hi);
  }

  .scale {
    list-style: none;
    display: flex;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
  }

  .scale li {
    flex: 1;
    margin: 0;
    padding: 0.2rem 0;
    border-radius: 6px;
    border: 1px solid var(--border);
    text-align: center;
    font: 500 0.62rem / 1.3 var(--font-mono);
    color: var(--muted);
  }

  .scale li.on {
    border-color: var(--sun);
    color: var(--sun);
    box-shadow: 0 0 14px -6px var(--sun);
  }

  .v-text {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font: 600 0.85rem / 1.35 var(--font-sans);
    color: var(--text);
  }

  .v-text :global(.icon) {
    flex: none;
    color: var(--sun);
  }

  @keyframes lit {
    0%,
    18%,
    100% {
      border-left-color: color-mix(in srgb, var(--mint) 55%, transparent);
    }
    6%,
    12% {
      border-left-color: var(--mint);
      background: color-mix(in srgb, var(--mint) 8%, var(--bg-2));
    }
  }
</style>
