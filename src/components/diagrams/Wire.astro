---
/**
 * Animated connector between diagram nodes: a flowing dashed line, a travelling
 * light dot, an arrowhead and an optional label. Orientation can differ between
 * phones (`dirMobile`) and wide screens (`dir`). Decorative: the nodes and the
 * text around the diagram carry the meaning, so it is aria-hidden.
 */
interface Props {
  area: string;
  /** Direction on wide screens. */
  dir: 'right' | 'left' | 'down' | 'up';
  /** Direction on phones (defaults to down). */
  dirMobile?: 'down' | 'up';
  label?: string;
  /** Second label for a return flow (drawn with a second dot going back). */
  back?: string;
  proposed?: boolean;
  hideMobile?: boolean;
  delay?: number;
}

const { area, dir, dirMobile = 'down', label, back, proposed = false, hideMobile = false, delay = 0 } = Astro.props;
---

<div
  class:list={['wire', `d-${dir}`, `m-${dirMobile}`, { proposed, 'hide-m': hideMobile, bi: back }]}
  style={`grid-area:${area};--delay:${delay}s`}
  aria-hidden="true"
>
  <span class="track"><i class="dot"></i>{back && <i class="dot dot-back"></i>}</span>
  {
    (label || back) && (
      <span class="labels">
        {label && <span class="lbl">{label}</span>}
        {back && <span class="lbl lbl-back">{back}</span>}
      </span>
    )
  }
</div>

<style>
  .wire {
    --c: var(--accent-2);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 3.25rem;
  }

  .proposed {
    --c: var(--accent);
  }

  .track {
    position: absolute;
    border-radius: 2px;
  }

  .track::after {
    content: '';
    position: absolute;
    border: 6px solid transparent;
  }

  .dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
    opacity: 0;
    animation-duration: 2.6s;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-delay: var(--delay);
  }

  .dot-back {
    background: var(--sun);
    box-shadow: 0 0 10px var(--sun);
    animation-delay: calc(var(--delay) + 1.3s);
  }

  .labels {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .lbl {
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--border-hi);
    border-radius: 999px;
    background: var(--bg-2);
    font: 500 0.7rem / 1.35 var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
  }

  .lbl-back {
    color: var(--sun);
    border-color: color-mix(in srgb, var(--sun) 35%, transparent);
  }

  /* ---------- vertical (phones by default) ---------- */
  .m-down .track,
  .m-up .track {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: repeating-linear-gradient(180deg, var(--c) 0 6px, transparent 6px 11px) 0 0 / 2px 22px;
    animation: flow-down 1.1s linear infinite;
  }

  .m-up .track {
    animation-name: flow-up;
  }

  .m-down .track::after {
    bottom: -8px;
    left: -5px;
    border-top: 8px solid var(--c);
  }

  .m-up .track::after {
    top: -8px;
    left: -5px;
    border-bottom: 8px solid var(--c);
  }

  .m-down .dot,
  .m-up .dot {
    left: -3px;
    animation-name: dot-down;
  }

  .m-up .dot {
    animation-name: dot-up;
  }

  .bi.m-down .dot-back,
  .bi.m-up .dot-back {
    animation-name: dot-up;
  }

  .m-down .labels,
  .m-up .labels {
    margin-left: 0;
  }

  .hide-m {
    display: none;
  }

  @media (min-width: 52rem) {
    .hide-m {
      display: flex;
    }

    /* reset the phone orientation, then apply the wide-screen one */
    .wire .track {
      top: auto;
      bottom: auto;
      left: auto;
      right: auto;
      width: auto;
      height: auto;
      margin: 0;
    }

    .wire .track::after {
      top: auto;
      bottom: auto;
      left: auto;
      right: auto;
      border: 6px solid transparent;
    }

    .d-right .track,
    .d-left .track {
      left: 0;
      right: 0;
      top: 50%;
      height: 2px;
      margin-top: -1px;
      background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 11px) 0 0 / 22px 2px;
      animation: flow-right 1.1s linear infinite;
    }

    .d-left .track {
      animation-name: flow-left;
    }

    .d-right .track::after {
      right: -8px;
      top: -5px;
      border-left: 8px solid var(--c);
    }

    .d-left .track::after {
      left: -8px;
      top: -5px;
      border-right: 8px solid var(--c);
    }

    .d-right .dot,
    .d-left .dot {
      top: -3px;
      left: auto;
      animation-name: dot-right;
    }

    .d-left .dot,
    .bi.d-right .dot-back {
      animation-name: dot-left;
    }

    .d-right .labels,
    .d-left .labels {
      transform: translateY(-0.2rem);
    }

    .d-down .track,
    .d-up .track {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      margin-left: -1px;
      background: repeating-linear-gradient(180deg, var(--c) 0 6px, transparent 6px 11px) 0 0 / 2px 22px;
      animation: flow-down 1.1s linear infinite;
    }

    .d-up .track {
      animation-name: flow-up;
    }

    .d-down .track::after {
      bottom: -8px;
      left: -5px;
      border-top: 8px solid var(--c);
    }

    .d-up .track::after {
      top: -8px;
      left: -5px;
      border-bottom: 8px solid var(--c);
    }

    .d-down .dot,
    .d-up .dot {
      left: -3px;
      top: auto;
      animation-name: dot-down;
    }

    .d-up .dot,
    .bi.d-down .dot-back {
      animation-name: dot-up;
    }
  }

  @keyframes flow-down {
    to {
      background-position: 0 22px;
    }
  }

  @keyframes flow-up {
    to {
      background-position: 0 -22px;
    }
  }

  @keyframes flow-right {
    to {
      background-position: 22px 0;
    }
  }

  @keyframes flow-left {
    to {
      background-position: -22px 0;
    }
  }

  @keyframes dot-down {
    0% {
      top: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 8px);
      opacity: 0;
    }
  }

  @keyframes dot-up {
    0% {
      top: calc(100% - 8px);
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: 0;
      opacity: 0;
    }
  }

  @keyframes dot-right {
    0% {
      left: 0;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 8px);
      opacity: 0;
    }
  }

  @keyframes dot-left {
    0% {
      left: calc(100% - 8px);
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: 0;
      opacity: 0;
    }
  }
</style>
