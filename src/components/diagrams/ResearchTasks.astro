---
/**
 * Article "ia-e-informacao-politica": the five tasks behind researching a candidate,
 * from the one technology helps most with (finding) to the one it cannot do for you
 * (deciding). ILLUSTRATIVE: the author's reading, not a measurement.
 */
import DiagramFrame from './DiagramFrame.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pt = lang === 'pt';

const title = pt ? 'Cinco tarefas que a gente chama de “pesquisar”' : 'Five tasks we lump together as “research”';
const caption = pt
  ? 'Leitura minha, não medição. A fronteira entre as etapas muda de caso para caso, e cada uma depende da anterior.'
  : 'My reading, not a measurement. The line between the steps shifts case by case, and each one depends on the previous.';
const techLabel = pt ? 'a tecnologia' : 'technology';
const youLabel = pt ? 'você' : 'you';
const scale = pt
  ? { left: 'a máquina carrega mais', right: 'depende mais de você' }
  : { left: 'the machine carries more', right: 'depends more on you' };

const steps: { icon: IconName; title: string; what: string; tech: string; you: string }[] = [
  {
    icon: 'search',
    title: pt ? 'Encontrar' : 'Find',
    what: pt ? 'achar o documento certo' : 'locate the right document',
    tech: pt ? 'busca, portais oficiais, dados abertos' : 'search, official portals, open data',
    you: pt ? 'saber o que procurar' : 'know what to look for',
  },
  {
    icon: 'list-checks',
    title: pt ? 'Organizar e comparar' : 'Organize and compare',
    what: pt ? 'pôr lado a lado, com os mesmos critérios' : 'side by side, with the same criteria',
    tech: pt ? 'separar por tema, achar trechos' : 'group by topic, find passages',
    you: pt ? 'definir os critérios' : 'set the criteria',
  },
  {
    icon: 'shield-check',
    title: pt ? 'Verificar' : 'Verify',
    what: pt ? 'conferir cada afirmação na fonte' : 'check each claim against the source',
    tech: pt ? 'apontar onde conferir' : 'point to where to check',
    you: pt ? 'abrir o original e ler' : 'open the original and read it',
  },
  {
    icon: 'layers',
    title: pt ? 'Interpretar' : 'Interpret',
    what: pt ? 'contexto, competência e responsabilidade' : 'context, powers and responsibility',
    tech: pt ? 'levantar perguntas e hipóteses' : 'raise questions and hypotheses',
    you: pt ? 'pesar as evidências' : 'weigh the evidence',
  },
  {
    icon: 'scale',
    title: pt ? 'Decidir' : 'Decide',
    what: pt ? 'escolher segundo valores e prioridades' : 'choose by values and priorities',
    tech: pt ? 'não decide por você' : 'does not decide for you',
    you: pt ? 'decide' : 'decide',
  },
];
---

<DiagramFrame lang={lang} id="dg-tasks" title={title} status="illustrative" caption={caption}>
  <ol class="tasks">
    {
      steps.map((s, i) => (
        <li style={`--i:${i}`}>
          <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="t-icon" aria-hidden="true">
            <Icon name={s.icon} size={18} />
          </span>
          <p class="t-title">{s.title}</p>
          <p class="t-what">{s.what}</p>
          <p class="t-row">
            <span class="k k-tech">{techLabel}</span>
            {s.tech}
          </p>
          <p class="t-row">
            <span class="k k-you">{youLabel}</span>
            {s.you}
          </p>
        </li>
      ))
    }
  </ol>
  <div class="scale" aria-hidden="true">
    <span>{scale.left}</span>
    <span class="bar"></span>
    <span>{scale.right}</span>
  </div>
</DiagramFrame>

<style>
  .tasks {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .tasks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .tasks {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .tasks li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
    margin: 0;
    padding: 0.85rem 0.8rem 0.8rem;
    border: 1px solid var(--border-hi);
    border-radius: var(--r);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    /* the human share grows step by step: a warmer border towards "decide" */
    border-color: color-mix(in srgb, var(--sun) calc(var(--i) * 12%), var(--border-hi));
    animation: rise 7.5s ease-in-out infinite;
    animation-delay: calc(var(--i) * 1.5s);
  }

  .n {
    position: absolute;
    top: 0.55rem;
    right: 0.65rem;
    font: 500 0.62rem / 1 var(--font-mono);
    color: var(--muted);
  }

  .t-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 10px;
    background: linear-gradient(135deg, var(--brand), var(--accent-2));
    color: var(--text);
  }

  .t-title {
    margin: 0.15rem 0 0;
    font: 700 0.98rem / 1.15 var(--font-display);
  }

  .t-what {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .t-row {
    margin: 0;
    font-size: 0.76rem;
    line-height: 1.35;
  }

  .k {
    display: inline-block;
    margin-right: 0.35rem;
    padding: 0.02rem 0.4rem;
    border-radius: 999px;
    font: 600 0.6rem / 1.4 var(--font-mono);
    vertical-align: 0.08em;
  }

  .k-tech {
    color: var(--mint);
    border: 1px solid color-mix(in srgb, var(--mint) 40%, transparent);
  }

  .k-you {
    color: var(--sun);
    border: 1px solid color-mix(in srgb, var(--sun) 40%, transparent);
  }

  .scale {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font: 500 0.66rem / 1.3 var(--font-mono);
    color: var(--muted);
  }

  .bar {
    flex: 1;
    height: 6px;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--mint), var(--accent-2) 50%, var(--sun));
  }

  @keyframes rise {
    0%,
    16%,
    100% {
      transform: none;
      box-shadow: none;
    }
    6%,
    11% {
      transform: translateY(-3px);
      box-shadow: 0 0 20px -8px var(--accent);
    }
  }
</style>
