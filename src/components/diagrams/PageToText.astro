---
/**
 * Article "interface-como-integracao": how a decision model could "see" a page.
 * Screen → text state (accessibility-tree-like) → typed decision. PROPOSED and
 * ILLUSTRATIVE: no values here come from a test.
 */
import DiagramFrame from './DiagramFrame.astro';
import Icon from '../ui/Icon.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const pt = lang === 'pt';
const T = {
  title: pt ? 'Como um modelo de decisão enxergaria a tela' : 'How a decision model would see the screen',
  caption: pt
    ? 'Ilustrativo: nenhum valor vem de teste. O modelo só escolhe entre alvos que o código já listou; credenciais e dados sensíveis ficam de fora do texto.'
    : 'Illustrative: no value comes from a test. The model only chooses among targets the code already listed; credentials and sensitive data stay out of the text.',
  screen: pt ? 'tela' : 'screen',
  text: pt ? 'estado em texto' : 'state as text',
  decision: pt ? 'decisão tipada' : 'typed decision',
  order: pt ? 'Número do pedido' : 'Order number',
  issue: pt ? 'Emitir 2ª via' : 'Reissue copy',
  cancel: pt ? 'Cancelar pedido' : 'Cancel order',
  choiceQ: pt ? 'qual alvo emite a 2ª via?' : 'which target reissues the copy?',
  noulQ: pt ? 'a tela mostra a confirmação?' : 'does the screen show the confirmation?',
  conf: pt ? 'confiança' : 'confidence',
  ask: pt ? 'abaixo do limiar → pergunta a uma pessoa' : 'below threshold → ask a person',
};
---

<DiagramFrame lang={lang} id="dg-page" title={T.title} status="illustrative" caption={T.caption}>
  <div class="ptt">
    <div class="panel">
      <p class="k"><Icon name="app-window" size={13} />{T.screen}</p>
      <div class="screen" aria-hidden="true">
        <span class="s-label">{T.order}</span>
        <span class="s-input">48213</span>
        <span class="s-btns">
          <span class="s-btn primary">{T.issue}</span>
          <span class="s-btn danger">{T.cancel}</span>
        </span>
        <span class="cursor"><Icon name="click" size={16} /></span>
      </div>
    </div>

    <span class="arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>

    <div class="panel">
      <p class="k"><Icon name="scan-text" size={13} />{T.text}</p>
      <pre class="tree"><code><span>[1] textbox  "{T.order}"</span>
<span class="hit">[2] button   "{T.issue}"</span>
<span>[3] button   "{T.cancel}"</span></code></pre>
    </div>

    <span class="arrow" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>

    <div class="panel">
      <p class="k"><Icon name="list-checks" size={13} />{T.decision}</p>
      <div class="dec">
        <p class="q"><span class="prim">Choice</span>{T.choiceQ}</p>
        <p class="a">→ <strong>[2]</strong> <span class="meter" aria-hidden="true"><i style="--v:0.86"></i></span> <span class="m-k">{T.conf}</span></p>
        <p class="q"><span class="prim">Noul</span>{T.noulQ}</p>
        <p class="a">→ <span class="meter" aria-hidden="true"><i style="--v:0.7"></i></span> <span class="m-k">0…1</span></p>
        <p class="ask"><Icon name="user-check" size={13} />{T.ask}</p>
      </div>
    </div>
  </div>
</DiagramFrame>

<style>
  .ptt {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  @media (min-width: 52rem) {
    .ptt {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.1fr) auto minmax(0, 1.1fr);
      gap: 0.75rem;
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid var(--border-hi);
    border-radius: var(--r);
    background: color-mix(in srgb, var(--surface) 90%, transparent);
  }

  .k {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0;
    font: 500 0.7rem / 1 var(--font-mono);
    color: var(--accent);
  }

  .arrow {
    display: grid;
    place-items: center;
    color: var(--mint);
    transform: rotate(90deg);
    animation: nudge 2.4s ease-in-out infinite;
  }

  @media (min-width: 52rem) {
    .arrow {
      transform: none;
    }
  }

  /* fake screen */
  .screen {
    position: relative;
    display: grid;
    gap: 0.45rem;
    padding: 0.7rem;
    border-radius: 10px;
    background: var(--bg-2);
    border: 1px solid var(--border);
  }

  .s-label {
    font-size: 0.7rem;
    color: var(--muted);
  }

  .s-input {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--border-hi);
    border-radius: 6px;
    font: 500 0.75rem / 1.2 var(--font-mono);
  }

  .s-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .s-btn {
    padding: 0.3rem 0.55rem;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    background: var(--surface-2);
    border: 1px solid var(--border-hi);
  }

  .s-btn.primary {
    border-color: var(--mint);
    color: var(--mint);
    animation: target 4s ease-in-out infinite;
  }

  .s-btn.danger {
    color: var(--muted);
  }

  .cursor {
    position: absolute;
    right: 18%;
    bottom: 0.4rem;
    color: var(--text);
    animation: cursor 4s ease-in-out infinite;
  }

  /* text state */
  .tree {
    margin: 0;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    background: var(--bg-2);
    border: 1px solid var(--border);
    font: 500 0.7rem / 1.7 var(--font-mono);
    color: var(--muted);
    white-space: pre;
    overflow-x: auto;
  }

  .tree .hit {
    color: var(--mint);
    animation: hit 4s ease-in-out infinite;
  }

  /* decision */
  .dec {
    display: grid;
    gap: 0.3rem;
  }

  .dec p {
    margin: 0;
  }

  .q {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.74rem;
    color: var(--muted);
  }

  .prim {
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand) 35%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    font: 600 0.64rem / 1.3 var(--font-mono);
    color: var(--accent);
  }

  .a {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font: 500 0.75rem / 1.4 var(--font-mono);
  }

  .meter {
    flex: 1;
    max-width: 6rem;
    height: 6px;
    border-radius: 6px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .meter i {
    display: block;
    height: 100%;
    width: calc(var(--v) * 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--accent-2), var(--mint));
    transform-origin: left;
    animation: fill 4s ease-out infinite;
  }

  .m-k {
    font-size: 0.64rem;
    color: var(--muted);
  }

  .ask {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.35rem !important;
    padding-top: 0.45rem;
    border-top: 1px dashed var(--border-hi);
    font: 500 0.66rem / 1.35 var(--font-mono);
    color: var(--sun);
  }

  @keyframes nudge {
    50% {
      opacity: 0.5;
    }
  }

  @keyframes target {
    0%,
    100% {
      box-shadow: none;
    }
    40%,
    70% {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--mint) 35%, transparent);
    }
  }

  @keyframes cursor {
    0%,
    100% {
      transform: translate(1.5rem, 0.8rem);
      opacity: 0;
    }
    30%,
    70% {
      transform: translate(0, 0);
      opacity: 1;
    }
  }

  @keyframes hit {
    0%,
    25%,
    100% {
      color: var(--muted);
    }
    40%,
    80% {
      color: var(--mint);
    }
  }

  @keyframes fill {
    0% {
      transform: scaleX(0);
    }
    50%,
    100% {
      transform: scaleX(1);
    }
  }
</style>
