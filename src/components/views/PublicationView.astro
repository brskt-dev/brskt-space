---
/** A single publication (product / experiment / article). */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PubMeta from '../PubMeta.astro';
import ExternalLink from '../ExternalLink.astro';
import { pathFor, t, type Lang } from '../../i18n/ui';
import { getPublications } from '../../lib/publications';
import { isExternal } from '../../lib/url';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const pub = (await getPublications()).find((p) => p.slug === slug);
if (!pub) throw new Error(`[publications] Unknown publication "${slug}"`);
const entry = pub.entries[lang];
const data = entry.data;
const { Content } = await render(entry);
const backKey = pub.section === 'articles' ? 'pub.back.articles' : 'pub.back.projects';
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.summary}
  ref={{ kind: 'publication', type: pub.type, slug }}
  ogType="article"
>
  <article class="wrap pub">
    <header class="page-head pub-head">
      <PubMeta lang={lang} type={pub.type} status={pub.status} date={data.date} updated={data.updated} />
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      {
        data.tags.length > 0 && (
          <ul class="tags pub-tags" aria-label={t(lang, 'pub.tags')}>
            {data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      {
        data.links.length > 0 && (
          <ul class="pub-links" aria-label={t(lang, 'pub.links')}>
            {data.links.map((l) => (
              <li>
                {isExternal(l.url) ? (
                  <ExternalLink class="text-link" href={l.url} lang={lang}>
                    {l.label}
                  </ExternalLink>
                ) : (
                  <a class="text-link" href={l.url}>
                    {l.label}
                  </a>
                )}
              </li>
            ))}
          </ul>
        )
      }
      <span class="rule" aria-hidden="true"></span>
    </header>

    {
      data.cover && (
        <Image
          class="cover"
          src={data.cover}
          alt=""
          widths={[640, 960, 1280]}
          sizes="(min-width: 70rem) 68ch, 100vw"
        />
      )
    }

    <div class="prose pub-body">
      <Content />
    </div>

    <p class="back">
      <a class="text-link" href={pathFor(lang, pub.section)}>
        <span class="arrow back-arrow" aria-hidden="true">←</span>{t(lang, backKey)}
      </a>
    </p>
  </article>
</BaseLayout>

<style>
  .pub-head :global(.pub-meta) {
    margin-bottom: 1rem;
  }

  .pub-tags {
    margin-top: 1.25rem;
  }

  .pub-links {
    list-style: none;
    padding: 0;
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.5rem;
  }

  .rule {
    display: block;
    max-width: var(--measure);
    height: 2px;
    margin-top: 1.75rem;
    background: var(--brand-grad);
    border-radius: 2px;
  }

  .cover {
    width: 100%;
    max-width: var(--measure);
    margin-bottom: 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .pub-body {
    padding-top: 0.5rem;
  }

  .back {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    max-width: var(--measure);
  }

  .text-link .back-arrow {
    margin-inline: 0 0.45em;
  }

  .text-link:hover .back-arrow {
    transform: translateX(-3px);
  }
</style>
