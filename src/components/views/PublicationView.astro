---
/** A single publication (product / experiment / article): cover banner, chips, title, lead, body. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExternalLink from '../ExternalLink.astro';
import Reactions from '../Reactions.astro';
import Cover from '../ui/Cover.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import { formatDate, isoDate, pathFor, statusLabel, t, typeLabel, type Lang, type PublicationType } from '../../i18n/ui';
import { getPublications } from '../../lib/publications';
import { isExternal } from '../../lib/url';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const pub = (await getPublications()).find((p) => p.slug === slug);
if (!pub) throw new Error(`[publications] Unknown publication "${slug}"`);
const entry = pub.entries[lang];
const data = entry.data;
const { Content } = await render(entry);
const backKey = pub.section === 'articles' ? 'pub.back.articles' : 'pub.back.projects';
const typeIcon: Record<PublicationType, IconName> = { product: 'package', article: 'file-text', experiment: 'flask' };
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.summary}
  ref={{ kind: 'publication', type: pub.type, slug }}
  ogType="article"
>
  <article class="wrap pub">
    <p class="back-top">
      <a class="btn btn-ghost" href={pathFor(lang, pub.section)}>
        <Icon name="arrow-left" size={16} class="back-icon" />
        {t(lang, backKey)}
      </a>
    </p>

    <div class="banner" aria-hidden="true">
      {
        data.cover ? (
          <Image src={data.cover} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 76rem) 76rem, 100vw" />
        ) : (
          <Cover seed={pub.slug} kind={pub.type} />
        )
      }
    </div>

    <header class="pub-head">
      <p class="badges">
        <span class="chip chip-accent"><Icon name={typeIcon[pub.type]} size={13} />{typeLabel(lang, pub.type)}</span>
        {
          pub.status && (
            <span class="chip chip-mint">
              <span class="sr-only">{t(lang, 'meta.status')}: </span>
              <span class="pulse" aria-hidden="true" />
              {statusLabel(lang, pub.status)}
            </span>
          )
        }
        <span class="chip">
          <Icon name="clock" size={13} />
          <span class="sr-only">{t(lang, 'meta.date')}: </span>
          <time datetime={isoDate(data.date)}>{formatDate(lang, data.date)}</time>
        </span>
        {
          data.updated && (
            <span class="chip">
              {t(lang, 'meta.updated')}: <time datetime={isoDate(data.updated)}>{formatDate(lang, data.updated)}</time>
            </span>
          )
        }
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      {
        data.tags.length > 0 && (
          <ul class="tag-list" aria-label={t(lang, 'pub.tags')}>
            {data.tags.map((tag) => (
              <li class="chip">#{tag}</li>
            ))}
          </ul>
        )
      }
      {
        data.links.length > 0 && (
          <ul class="pub-links" aria-label={t(lang, 'pub.links')}>
            {data.links.map((l) =>
              isExternal(l.url) ? (
                <li>
                  <ExternalLink class="btn" href={l.url} lang={lang}>
                    {l.label}
                  </ExternalLink>
                </li>
              ) : (
                <li>
                  <a class="btn" href={l.url}>
                    {l.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        )
      }
    </header>

    <div class="prose pub-body">
      <Content />
    </div>

    <Reactions lang={lang} slug={slug} />
  </article>
</BaseLayout>

<style>
  .pub {
    max-width: calc(58rem + 2 * var(--gutter));
  }

  .back-top {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .back-top .btn {
    padding-inline: 0.6rem 1rem;
  }

  .back-top .btn:hover :global(.back-icon) {
    transform: translateX(-3px);
  }

  .banner {
    margin-top: 1rem;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-2);
  }

  .banner > :global(*) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pub-head {
    position: relative;
    margin: -2.5rem 1rem 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border-hi);
    border-radius: var(--r-lg);
    background: rgb(21 16 38 / 0.92);
    backdrop-filter: blur(10px);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pub-head h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: 0.75rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--muted);
  }

  .pub-head .tag-list {
    margin-top: 1.1rem;
  }

  .pub-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .pub-body {
    margin: clamp(2rem, 5vw, 3rem) auto 0;
  }

  /* each h2 opens a small "block" */
  .pub-body :global(h2) {
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-hi);
  }

  .pub-body :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  @media (max-width: 40rem) {
    .pub-head {
      margin-inline: 0;
      margin-top: -1.5rem;
    }
  }
</style>
