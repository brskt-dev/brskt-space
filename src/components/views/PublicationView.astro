---
/** A single publication (product / experiment / article): cover banner, chips, title, lead, body. */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExternalLink from '../ExternalLink.astro';
import Reactions from '../Reactions.astro';
import SectionHeading from '../SectionHeading.astro';
import Cover from '../ui/Cover.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import { formatDate, isoDate, pathFor, statusLabel, t, typeLabel, type Lang, type PublicationType } from '../../i18n/ui';
import { getPublications } from '../../lib/publications';
import { isExternal } from '../../lib/url';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props;
const pub = (await getPublications()).find((p) => p.slug === slug);
if (!pub) throw new Error(`[publications] Unknown publication "${slug}"`);
const entry = pub.entries[lang];
const data = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const backKey = pub.section === 'articles' ? 'pub.back.articles' : 'pub.back.projects';
const typeIcon: Record<PublicationType, IconName> = { product: 'package', article: 'file-text', experiment: 'flask' };
---

<BaseLayout
  lang={lang}
  title={data.title}
  description={data.summary}
  ref={{ kind: 'publication', type: pub.type, slug }}
  ogType="article"
>
  <article class="wrap pub">
    <p class="back-top">
      <a class="btn btn-ghost" href={pathFor(lang, pub.section)}>
        <Icon name="arrow-left" size={16} class="back-icon" />
        {t(lang, backKey)}
      </a>
    </p>

    <div class="banner" aria-hidden="true">
      {
        data.cover ? (
          <Image src={data.cover} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 76rem) 76rem, 100vw" />
        ) : (
          <Cover seed={pub.slug} kind={pub.type} />
        )
      }
    </div>

    <header class="pub-head">
      <p class="badges">
        <span class="chip chip-accent"><Icon name={typeIcon[pub.type]} size={13} />{typeLabel(lang, pub.type)}</span>
        {
          pub.status && (
            <span class="chip chip-mint">
              <span class="sr-only">{t(lang, 'meta.status')}: </span>
              <span class="pulse" aria-hidden="true" />
              {statusLabel(lang, pub.status)}
            </span>
          )
        }
        <span class="chip">
          <Icon name="clock" size={13} />
          <span class="sr-only">{t(lang, 'meta.date')}: </span>
          <time datetime={isoDate(data.date)}>{formatDate(lang, data.date)}</time>
        </span>
        {
          data.updated && (
            <span class="chip">
              {t(lang, 'meta.updated')}: <time datetime={isoDate(data.updated)}>{formatDate(lang, data.updated)}</time>
            </span>
          )
        }
      </p>
      <h1>{data.title}</h1>
      <p class="lead">{data.summary}</p>
      {
        data.tags.length > 0 && (
          <ul class="tag-list" aria-label={t(lang, 'pub.tags')}>
            {data.tags.map((tag) => (
              <li class="chip">#{tag}</li>
            ))}
          </ul>
        )
      }
      {
        data.links.length > 0 && (
          <ul class="pub-links" aria-label={t(lang, 'pub.links')}>
            {data.links.map((l, i) =>
              isExternal(l.url) ? (
                <li>
                  <ExternalLink class={i === 0 ? 'btn btn-primary' : 'btn'} href={l.url} lang={lang}>
                    {i === 0 && <Icon name="rocket" size={16} />}
                    {l.label}
                  </ExternalLink>
                </li>
              ) : (
                <li>
                  <a class="btn" href={l.url}>
                    {l.label}
                  </a>
                </li>
              ),
            )}
          </ul>
        )
      }
    </header>

    {
      data.stats.length > 0 && (
        <section class="stats" aria-label={t(lang, 'pub.stats')}>
          <ul>
            {data.stats.map((st) => (
              <li class="card stat reveal">
                <span class="stat-v">{st.value}</span>
                <span class="stat-l">{st.label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label={t(lang, 'pub.toc')}>
          <p class="kicker">
            <Icon name="orbit" size={15} />
            {t(lang, 'pub.toc')}
          </p>
          <ul class="tag-list">
            {toc.map((h) => (
              <li>
                <a class="chip toc-link" href={`#${h.slug}`}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      data.gallery.length > 0 && (
        <section class="gallery-wrap" aria-labelledby="gallery-title">
          <SectionHeading id="gallery-title" kicker={t(lang, 'pub.galleryKicker')} icon="telescope">
            {t(lang, 'pub.gallery')}
          </SectionHeading>
          <div class="gallery">
            {data.gallery.map((g) => (
              <figure class:list={['card', 'shot', 'reveal', g.orientation]}>
                <Image
                  src={g.src}
                  alt={g.alt}
                  widths={g.orientation === 'portrait' ? [300, 600] : [600, 900, 1200]}
                  sizes={g.orientation === 'portrait' ? '(min-width: 48rem) 18rem, 70vw' : '(min-width: 58rem) 42rem, 100vw'}
                />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <div class="prose pub-body">
      <Content />
    </div>

    {
      data.stack.length > 0 && (
        <section class="stack-wrap" aria-labelledby="stack-title">
          <SectionHeading id="stack-title" kicker={t(lang, 'pub.stackKicker')} icon="layers">
            {t(lang, 'pub.stack')}
          </SectionHeading>
          <ul class="tag-list">
            {data.stack.map((x) => (
              <li class="chip chip-accent stack-chip">{x}</li>
            ))}
          </ul>
        </section>
      )
    }

    <Reactions lang={lang} slug={slug} />
  </article>
</BaseLayout>

<style>
  .pub {
    max-width: calc(58rem + 2 * var(--gutter));
  }

  .pub-body :global(table) {
    width: 100%;
  }

  .back-top {
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .back-top .btn {
    padding-inline: 0.6rem 1rem;
  }

  .back-top .btn:hover :global(.back-icon) {
    transform: translateX(-3px);
  }

  .banner {
    margin-top: 1rem;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--bg-2);
  }

  .banner > :global(*) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pub-head {
    position: relative;
    margin: -2.5rem 1rem 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--border-hi);
    border-radius: var(--r-lg);
    background: rgb(21 16 38 / 0.92);
    backdrop-filter: blur(10px);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pub-head h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 1.5rem + 3.4vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: 0.75rem;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.5;
    color: var(--muted);
  }

  .pub-head .tag-list {
    margin-top: 1.1rem;
  }

  .pub-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .pub-body {
    margin: clamp(2rem, 5vw, 3rem) auto 0;
  }

  /* each h2 opens a small "block" */
  .pub-body :global(h2) {
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-hi);
  }

  .pub-body :global(h2:first-child) {
    padding-top: 0;
    border-top: 0;
  }

  /* ---------- Stats ---------- */
  .stats ul {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
  }

  .stat {
    gap: 0.25rem;
    padding: 1rem 1.1rem;
  }

  .stat-v {
    font: 800 clamp(1.6rem, 1.3rem + 1vw, 2.1rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
    background: linear-gradient(120deg, #fff, var(--accent), var(--mint));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat-l {
    font-size: var(--fs-meta);
    line-height: 1.35;
    color: var(--muted);
  }

  /* ---------- TOC ---------- */
  .toc {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .toc-link {
    min-height: 2.25rem;
    padding-inline: 0.8rem;
    color: var(--text);
    text-decoration: none;
    white-space: normal;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      transform 180ms var(--ease-out);
  }

  .toc-link:hover {
    border-color: var(--accent-2);
    background: var(--surface-2);
    color: var(--text);
    transform: translateY(-2px);
  }

  /* ---------- Gallery ---------- */
  .gallery-wrap,
  .stack-wrap {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
  }

  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr);
      grid-auto-flow: row dense;
      align-items: start;
    }

    .shot.landscape {
      grid-column: 1;
    }

    .shot.landscape:first-child {
      grid-column: 1 / -1;
    }

    .shot.portrait {
      grid-column: 2;
      grid-row: span 2;
    }
  }

  .shot {
    height: auto;
    margin: 0;
  }

  .shot :global(img) {
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--border);
  }

  .shot.portrait {
    max-width: 20rem;
    justify-self: center;
  }

  .shot figcaption {
    padding: 0.7rem 1rem 0.85rem;
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  .stack-chip {
    padding: 0.4rem 0.8rem;
    font-size: 0.82rem;
  }

  /* anchor targets clear the sticky header */
  .pub-body :global(h2) {
    scroll-margin-top: 6rem;
  }

  @media (max-width: 40rem) {
    .pub-head {
      margin-inline: 0;
      margin-top: -1.5rem;
    }
  }
</style>
