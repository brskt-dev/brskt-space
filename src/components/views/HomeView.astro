---
/**
 * Home: hero (photo in orbit, terminal greeting, intro, availability, CTAs) →
 * Projects (a row of 4: real projects + skeleton slots) → Articles (a 4×2 grid:
 * real articles + skeleton slots, "View all" enabled once one exists) →
 * onboard gear (stack marquee). Copy comes from src/content/pages/home/<lang>.md.
 */
import { getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import PublicationCard from '../PublicationCard.astro';
import SkeletonCard from '../SkeletonCard.astro';
import Icon from '../ui/Icon.astro';
import photo from '../../assets/bruno-anhezini.jpg';
import { profile } from '../../data/profile';
import { pathFor, t, type Lang } from '../../i18n/ui';
import { getSection } from '../../lib/publications';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('home', lang);
if (!entry) throw new Error(`[home] Missing src/content/pages/home/${lang}.md`);
const { Content } = await render(entry);
const { title, description, headline, tagline, availability } = entry.data;

const PROJECT_SLOTS = 4;
const ARTICLE_SLOTS = 8;
const projects = await getSection('projects');
const articles = await getSection('articles');
const shownProjects = projects.slice(0, PROJECT_SLOTS);
const shownArticles = articles.slice(0, ARTICLE_SLOTS);
const projectSkeletons = Math.max(0, PROJECT_SLOTS - shownProjects.length);
const articleSkeletons = Math.max(0, ARTICLE_SLOTS - shownArticles.length);
---

<BaseLayout lang={lang} title={title} rawTitle description={description} ref={{ kind: 'page', page: 'home' }} ogType="profile">
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="prompt mono" aria-hidden="true">
        <span class="p-user">bruno@brskt</span><span class="p-sep">:</span><span class="p-path">~</span><span
          class="p-sep">$</span
        >
        <span class="typed">{t(lang, 'home.prompt')}</span><span class="caret"></span>
      </p>
      <h1 id="hero-title">{headline}</h1>
      <p class="tagline">{tagline}</p>
      <div class="intro">
        <Content />
      </div>
      <p class="chip chip-mint avail"><span class="pulse" aria-hidden="true"></span>{availability}</p>
      <ul class="hero-ctas">
        {
          projects.length > 0 && (
            <li>
              <a class="btn btn-primary" href="#projects-title">
                <Icon name="rocket" />
                {t(lang, 'home.ctaProjects')}
              </a>
            </li>
          )
        }
        <li>
          <a class="btn" href={pathFor(lang, 'about')}>
            <Icon name="user" />
            {t(lang, 'home.aboutLink')}
            <Icon name="arrow-right" size={16} class="icon-move" />
          </a>
        </li>
        <li>
          <a class="btn btn-ghost" href={`mailto:${profile.contact.email}`}>
            <Icon name="mail" />
            <span><span class="sr-only">e-mail: </span>{profile.contact.email}</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="orbits">
        <span class="orbit o1"><span class="body b1"></span></span>
        <span class="orbit o2"><span class="body b2"></span></span>
        <span class="orbit o3"><span class="body b3"></span></span>
        <div class="avatar">
          <Picture
            src={photo}
            alt=""
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={560}
            height={560}
            widths={[280, 420, 560]}
            sizes="(min-width: 64rem) 17rem, 13rem"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <span class="float-chip c1 chip">C#/.NET</span>
        <span class="float-chip c2 chip">Angular</span>
        <span class="float-chip c3 chip">SQL Server</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="wrap">
      <SectionHeading id="projects-title" kicker={t(lang, 'home.projectsKicker')} icon="rocket" sub={t(lang, 'home.projectsSub')}>
        {t(lang, 'home.projects')}
        {
          projects.length > PROJECT_SLOTS && (
            <a slot="action" class="btn" href={pathFor(lang, 'projects')}>
              {t(lang, 'home.allProjects')}
              <Icon name="arrow-right" size={16} class="icon-move" />
            </a>
          )
        }
      </SectionHeading>
      <div class="grid-4">
        {shownProjects.map((pub) => <PublicationCard lang={lang} pub={pub} />)}
        {Array.from({ length: projectSkeletons }, (_, i) => <SkeletonCard lang={lang} kind="project" index={i} extra={i >= 1} />)}
      </div>
      {projectSkeletons > 0 && <p class="soon-note">{t(lang, 'home.projectsSoon')}</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="articles-title">
    <div class="wrap">
      <SectionHeading id="articles-title" kicker={t(lang, 'home.articlesKicker')} icon="book-open" sub={t(lang, 'home.articlesSub')}>
        {t(lang, 'home.articles')}
        {
          articles.length > 0 ? (
            <a slot="action" class="btn" href={pathFor(lang, 'articles')}>
              {t(lang, 'home.allArticles')}
              <Icon name="arrow-right" size={16} class="icon-move" />
            </a>
          ) : (
            <span slot="action" class="btn" role="link" aria-disabled="true">
              {t(lang, 'home.allArticles')}
              <span class="chip">{t(lang, 'home.soon')}</span>
            </span>
          )
        }
      </SectionHeading>
      <div class="grid-4">
        {shownArticles.map((pub) => <PublicationCard lang={lang} pub={pub} />)}
        {Array.from({ length: articleSkeletons }, (_, i) => <SkeletonCard lang={lang} kind="article" index={i} extra={i >= 2} />)}
      </div>
      {articles.length === 0 && <p class="soon-note">{t(lang, 'home.articlesSoon')}</p>}
    </div>
  </section>

  <section class="section" aria-labelledby="stack-title">
    <div class="wrap">
      <SectionHeading id="stack-title" kicker={t(lang, 'home.stackKicker')} icon="wrench">
        {t(lang, 'home.stack')}
      </SectionHeading>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <ul>{profile.stack.map((x) => <li class="chip stack-chip">{x}</li>)}</ul>
        <ul aria-hidden="true">{profile.stack.map((x) => <li class="chip stack-chip">{x}</li>)}</ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(2.5rem, 7vw, 5.5rem);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .prompt {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 0.1rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgb(21 16 38 / 0.75);
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  .p-user {
    color: var(--mint);
  }

  .p-path {
    color: var(--accent);
  }

  .typed {
    display: inline-block;
    margin-left: 0.5rem;
    overflow: hidden;
    white-space: nowrap;
    color: var(--text);
    width: 6ch;
    animation: type 1.2s steps(6, end) 0.4s both;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }

  @keyframes type {
    from {
      width: 0;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.75rem, 1.4rem + 5.6vw, 5.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.98;
    background: linear-gradient(120deg, #fff 30%, var(--accent) 70%, var(--mint));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: clamp(1.15rem, 1.05rem + 0.5vw, 1.4rem);
    line-height: 1.45;
    color: var(--text);
  }

  .intro {
    margin-top: 1rem;
    max-width: 36rem;
    color: var(--muted);
  }

  .intro :global(p + p) {
    margin-top: 0.6rem;
  }

  .avail {
    margin-top: 1.4rem;
    white-space: normal;
    font-size: 0.8rem;
    padding: 0.35rem 0.8rem;
  }

  .hero-ctas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  /* ---------- Photo in orbit ---------- */
  .hero-visual {
    display: grid;
    place-items: center;
  }

  .orbits {
    position: relative;
    width: min(calc(100% - 3rem), 22rem); /* room for the outer orbit on phones */
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  @media (min-width: 64rem) {
    .orbits {
      width: min(100%, 27rem);
    }
  }

  .avatar {
    position: relative;
    z-index: 1;
    width: 60%;
    aspect-ratio: 1;
    padding: 5px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, var(--brand), var(--mint), var(--brand-hi), var(--sun), var(--brand));
    animation: spin 12s linear infinite;
    box-shadow: 0 0 80px -10px rgb(124 77 255 / 0.65);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--bg);
    animation: spin 12s linear infinite reverse; /* keeps the photo upright while the ring spins */
  }

  .orbit {
    position: absolute;
    border: 1px dashed rgb(179 157 255 / 0.28);
    border-radius: 50%;
    animation: spin linear infinite;
  }

  .o1 {
    inset: 12%;
    animation-duration: 16s;
  }

  .o2 {
    inset: 3%;
    border-color: rgb(94 234 212 / 0.22);
    animation-duration: 26s;
    animation-direction: reverse;
  }

  .o3 {
    inset: -6%;
    border-style: dotted;
    animation-duration: 40s;
  }

  .body {
    position: absolute;
    border-radius: 50%;
  }

  .b1 {
    top: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    background: var(--mint);
    box-shadow: 0 0 14px var(--mint);
  }

  .b2 {
    bottom: 10%;
    left: 6%;
    width: 18px;
    height: 18px;
    background: radial-gradient(circle at 35% 30%, #f0abfc, #7c3aed);
  }

  .b3 {
    top: 20%;
    right: -4px;
    width: 9px;
    height: 9px;
    background: var(--sun);
    box-shadow: 0 0 10px var(--sun);
  }

  .float-chip {
    position: absolute;
    z-index: 2;
    color: var(--text);
    background: rgb(29 23 54 / 0.9);
    border-color: var(--border-hi);
    animation: bob 5s ease-in-out infinite;
  }

  .c1 {
    top: 8%;
    left: 0;
  }

  .c2 {
    top: 46%;
    right: -2%;
    animation-delay: -1.6s;
  }

  .c3 {
    bottom: 6%;
    left: 14%;
    animation-delay: -3.2s;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes bob {
    50% {
      transform: translateY(-10px);
    }
  }

  /* ---------- Sections ---------- */
  .soon-note {
    margin-top: 1rem;
    font: 500 var(--fs-meta) / 1.5 var(--font-mono);
    color: var(--muted);
  }

  .soon-note::before {
    content: '✦ ';
    color: var(--accent-2);
  }

  .stack-chip {
    padding: 0.5rem 0.95rem;
    font-size: 0.85rem;
    color: var(--text);
    background: var(--surface);
  }
</style>
