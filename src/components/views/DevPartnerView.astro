---
/**
 * Landing of the "Dev parceiro" service: hero (WhatsApp CTA, orbit visual) →
 * "você se reconhece?" situations → what I do → how the ongoing work goes → AI vs me →
 * who I am → conditions ("Quanto custa": the only place with the price, from `offer`, and the
 * market comparison) → FAQ → closing CTA, plus a sticky CTA bar on phones. All copy lives in
 * src/content/pages/dev-partner/<lang>.md. The contract term is never shown (owner's choice:
 * it is told over WhatsApp).
 */
import { getEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import WhatsAppLink from '../WhatsAppLink.astro';
import ExternalLink from '../ExternalLink.astro';
import Rover from '../mascot/Rover.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import photo from '../../assets/bruno-anhezini.jpg';
import ogPt from '../../assets/og/dev-partner-pt.jpg';
import ogEn from '../../assets/og/dev-partner-en.jpg';
import { profile } from '../../data/profile';
import { pathFor, t, type Lang } from '../../i18n/ui';
import { formatOffer } from '../../lib/offer';
import { absoluteUrl } from '../../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('devPartner', lang);
if (!entry) throw new Error(`[dev-partner] Missing src/content/pages/dev-partner/${lang}.md`);
const d = entry.data;
const msg = d.whatsappMessage;

const { price, perMonth } = formatOffer(lang, d.offer);

// Icons follow the order of the items in the copy (see the comments in the .md files).
const recognizeIcons: IconName[] = ['repeat', 'unplug', 'sheet', 'wallet', 'lock', 'lightbulb'];
const doesIcons: IconName[] = ['zap', 'plug', 'list-checks', 'receipt', 'wrench', 'rocket'];
const stepIcons: IconName[] = ['message', 'telescope', 'list-checks', 'hammer', 'refresh'];
const orbitIcons: IconName[] = ['zap', 'plug', 'sheet', 'wallet', 'rocket', 'wrench'];
const icon = (list: IconName[], i: number): IconName => list[i % list.length];

const site = Astro.site ?? 'https://brskt-dev.github.io';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: t(lang, 'service.name'),
  description: d.description,
  url: absoluteUrl(pathFor(lang, 'devPartner'), site),
  areaServed: { '@type': 'Country', name: lang === 'pt' ? 'Brasil' : 'Brazil' },
  provider: {
    '@type': 'Person',
    name: profile.name,
    url: absoluteUrl(pathFor(lang, 'about'), site),
    sameAs: [profile.contact.linkedin, profile.contact.github],
  },
};
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.description}
  ref={{ kind: 'page', page: 'devPartner' }}
  ogImage={{ src: lang === 'pt' ? ogPt : ogEn, alt: t(lang, 'service.ogAlt') }}
  jsonLd={jsonLd}
  planet="mars"
>
  <div class="landing">
    <!-- Hero -->
    <section class="hero wrap" aria-labelledby="dp-title">
      <div class="hero-text">
        <p class="chip chip-mint kick"><span class="pulse" aria-hidden="true"></span>{d.hero.kicker}</p>
        <h1 id="dp-title">{d.hero.title}</h1>
        <p class="lead">{d.hero.lead}</p>
        <ul class="ctas">
          <li><WhatsAppLink lang={lang} message={msg} place="dev-parceiro-hero" /></li>
          <li>
            <a class="btn btn-ghost" href="#dp-how">
              {t(lang, 'service.howLink')}
              <Icon name="arrow-right" size={16} class="icon-move" />
            </a>
          </li>
        </ul>
        <p class="cta-note">{d.hero.ctaNote}</p>
      </div>

      <!-- Mars scene: the rover on the dunes, "your company" as a base, the kinds of work as tags in the sky -->
      <div class="scene-box" aria-hidden="true">
        <div class="scene">
          <span class="stars"></span>
          <span class="moon-a"></span>
          <span class="moon-b"></span>
          <svg class="ground" viewBox="0 0 400 220" preserveAspectRatio="none">
            <path class="dune-far" d="M0 62C58 34 118 52 178 42S300 18 400 44V220H0Z"></path>
            <path class="dune-mid" d="M0 104C82 74 160 98 232 82S342 70 400 92V220H0Z"></path>
            <path class="dune-near" d="M0 154C92 128 196 148 280 132S372 126 400 138V220H0Z"></path>
            <ellipse class="crater" cx="318" cy="182" rx="26" ry="6"></ellipse>
            <ellipse class="crater" cx="250" cy="206" rx="14" ry="3.5"></ellipse>
            <ellipse class="crater" cx="372" cy="160" rx="10" ry="2.5"></ellipse>
            <path class="tracks" d="M-8 206C30 198 60 200 96 196"></path>
            <path class="rock" d="M224 168l7-6 9 2 3 6z"></path>
            <path class="rock" d="M360 196l5-5 7 1 2 5z"></path>
          </svg>
          <svg class="signal" viewBox="0 0 400 400" preserveAspectRatio="none">
            <path d="M124 222Q226 112 338 184"></path>
          </svg>
          <div class="base">
            <span class="base-tag"><Icon name="briefcase" size={14} />{t(lang, 'service.orbitCore')}</span>
            <svg viewBox="0 0 120 70">
              <path class="base-mast" d="M84 22V6"></path>
              <circle class="base-light" cx="84" cy="5" r="3.5"></circle>
              <path class="base-glass" d="M14 60a46 46 0 0 1 92 0z"></path>
              <path class="base-grid" d="M60 14v46M30 30q30 10 60 0M20 46q40 10 80 0M37 22q-10 18-8 38M83 22q10 18 8 38"></path>
              <rect class="base-floor" x="6" y="58" width="108" height="9" rx="3"></rect>
              <rect class="base-door" x="52" y="44" width="16" height="15" rx="4"></rect>
            </svg>
          </div>
          <div class="scene-rover"><Rover pose="wave" mood="happy" size="100%" /></div>
          <ul class="tags">
            {
              d.hero.orbit.map((label, i) => (
                <li class="tag" style={`--i:${i}`}>
                  <Icon name={icon(orbitIcons, i)} size={13} />
                  {label}
                </li>
              ))
            }
          </ul>
          <p class="hud mono"><span class="pulse"></span>{t(lang, 'service.roverHud')}</p>
          <span class="corner c-tl"></span><span class="corner c-tr"></span><span class="corner c-bl"></span><span class="corner c-br"></span>
        </div>
      </div>
    </section>

    <!-- Você se reconhece? -->
    <section class="section wrap" aria-labelledby="dp-recognize">
      <SectionHeading id="dp-recognize" kicker={t(lang, 'service.recognizeKicker')} icon="eye" sub={d.recognize.intro}>
        {d.recognize.title}
        <div slot="action" class="rv-spot"><Rover pose="scan" mood="curious" size="100%" /></div>
      </SectionHeading>
      <ul class="cards">
        {
          d.recognize.items.map((it, i) => (
            <li class="card tile reveal">
              <span class="tile-icon" aria-hidden="true">
                <Icon name={icon(recognizeIcons, i)} size={20} />
              </span>
              <h3>{it.title}</h3>
              <p>{it.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- O que eu faço -->
    <section class="section wrap" aria-labelledby="dp-does">
      <SectionHeading id="dp-does" kicker={t(lang, 'service.doesKicker')} icon="wrench" sub={d.does.intro}>
        {d.does.title}
        <div slot="action" class="rv-spot"><Rover pose="build" mood="focused" size="100%" /></div>
      </SectionHeading>
      <ul class="does">
        {
          d.does.items.map((it, i) => (
            <li class="does-item reveal">
              <span class="does-icon" aria-hidden="true">
                <Icon name={icon(doesIcons, i)} size={18} />
              </span>
              <div>
                <h3>{it.title}</h3>
                <p>{it.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Como funciona -->
    <section class="section wrap" aria-labelledby="dp-how">
      <SectionHeading id="dp-how" kicker={t(lang, 'service.howKicker')} icon="orbit" sub={d.how.intro}>
        {d.how.title}
      </SectionHeading>
      <ol class="steps" style={`--steps:${d.how.steps.length}`}>
        {
          d.how.steps.map((st, i) => (
            <li class="step reveal">
              <span class="step-n mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="step-icon" aria-hidden="true">
                <Icon name={icon(stepIcons, i)} size={18} />
              </span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="loop-row">
        <p class="loop mono">
          <Icon name="refresh" size={15} />
          {d.how.loop}
        </p>
        <Rover pose="drive" mood="happy" size="6.5rem" class="loop-rover" />
      </div>
    </section>

    <!-- IA + eu -->
    <section class="section wrap" aria-labelledby="dp-ai">
      <SectionHeading id="dp-ai" kicker={t(lang, 'service.aiKicker')} icon="sparkles" sub={d.ai.text}>
        {d.ai.title}
        <div slot="action" class="rv-spot"><Rover pose="rest" mood="wink" size="100%" /></div>
      </SectionHeading>
      <div class="split">
        <div class="split-col ai-col reveal">
          <p class="split-label mono"><Icon name="sparkles" size={14} />{t(lang, 'service.aiLabel')}</p>
          <ul>{d.ai.aiPart.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="split-col me-col reveal">
          <p class="split-label mono"><Icon name="shield-check" size={14} />{t(lang, 'service.meLabel')}</p>
          <ul>{d.ai.mePart.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
    </section>

    <!-- Quem sou -->
    <section class="section wrap" aria-labelledby="dp-who">
      <div class="who card">
        <div class="who-photo">
          <Picture
            src={photo}
            alt={t(lang, 'about.photoAlt')}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            width={320}
            height={320}
            widths={[160, 240, 320]}
            sizes="10rem"
          />
        </div>
        <div>
          <p class="kicker"><Icon name="user" size={15} />{t(lang, 'service.whoKicker')}</p>
          <h2 id="dp-who">{d.who.title}</h2>
          <p class="who-text">{d.who.text}</p>
          <a class="btn btn-ghost" href={pathFor(lang, 'about')}>
            {t(lang, 'service.whoLink')}
            <Icon name="arrow-right" size={16} class="icon-move" />
          </a>
        </div>
      </div>
    </section>

    <!-- Condições -->
    <section class="section wrap" aria-labelledby="dp-conditions">
      <SectionHeading id="dp-conditions" kicker={t(lang, 'service.conditionsKicker')} icon="handshake" sub={d.conditions.intro}>
        {d.conditions.title}
      </SectionHeading>
      <div class="deal card">
        <div class="deal-price">
          <div class="price-row">
            <Rover pose="point" mood="excited" size="7rem" class="price-rover" />
            <p class="price">
              <span class="price-v">{price}</span>
              <span class="price-u">{perMonth}</span>
            </p>
          </div>
          <WhatsAppLink lang={lang} message={msg} place="dev-parceiro-condicoes" />
        </div>
        <div class="deal-points">
          <ul>
            {
              d.conditions.points.map((p) => (
                <li>
                  <Icon name="circle-check" size={18} />
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="compare">
        <h3 class="compare-title">{d.conditions.compare.title}</h3>
        <ul class="compare-list">
          <li class="compare-item is-me">
            <p class="compare-label mono"><Icon name="rocket" size={14} />{d.conditions.compare.me.label}</p>
            <p class="compare-price">{price}</p>
            <p class="compare-unit">{perMonth}</p>
            <p class="compare-text">{d.conditions.compare.me.text}</p>
          </li>
          {
            d.conditions.compare.others.map((o) => (
              <li class="compare-item">
                <p class="compare-label mono">{o.label}</p>
                <p class="compare-price">{o.price}</p>
                <p class="compare-unit">{o.unit}</p>
                <p class="compare-text">
                  {o.text}
                  <sup class="compare-ref mono">
                    <a href={`#dp-src-${o.source + 1}`} aria-label={`${t(lang, 'service.sourceLabel')} ${o.source + 1}`}>
                      [{o.source + 1}]
                    </a>
                  </sup>
                </p>
              </li>
            ))
          }
        </ul>
        <p class="compare-note">{d.conditions.compare.note}</p>
        <ol class="compare-sources">
          {
            d.conditions.compare.sources.map((src, i) => (
              <li id={`dp-src-${i + 1}`}>
                <ExternalLink href={src.url} lang={lang}>
                  {src.label}
                </ExternalLink>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section wrap" aria-labelledby="dp-faq">
      <SectionHeading id="dp-faq" kicker={t(lang, 'service.faqKicker')} icon="message">
        {d.faq.title}
        <div slot="action" class="rv-spot rv-narrow"><Rover pose="think" mood="thinking" size="100%" /></div>
      </SectionHeading>
      <div class="faq-wrap">
      <div class="faq">
        {
          d.faq.items.map((f) => (
            <details class="faq-item">
              <summary>
                <span>{f.q}</span>
                <Icon name="arrow-right" size={16} class="faq-arrow" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="faq-rover"><Rover pose="think" mood="thinking" size="100%" /></div>
      </div>
    </section>

    <!-- Fechamento -->
    <section class="section wrap" aria-labelledby="dp-closing">
      <div class="closing">
        <Rover pose="flag" mood="excited" size="9rem" />
        <h2 id="dp-closing">{d.closing.title}</h2>
        <p>{d.closing.text}</p>
        <WhatsAppLink lang={lang} message={msg} place="dev-parceiro-final" />
      </div>
    </section>

    <!-- Phones: the CTA stays at hand -->
    <div class="sticky-cta">
      <p>{t(lang, 'service.sticky')}</p>
      <WhatsAppLink lang={lang} message={msg} place="dev-parceiro-barra" />
    </div>
  </div>
</BaseLayout>

<style>
  .landing {
    padding-bottom: clamp(1rem, 4vw, 2rem);
  }

  /* ---------- Hero ---------- */
  .hero {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-top: clamp(2.5rem, 7vw, 5rem);
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .kick {
    white-space: normal;
  }

  .hero h1 {
    margin-top: 1rem;
    font-size: clamp(2.3rem, 1.4rem + 3.6vw, 4.2rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .lead {
    margin-top: 1rem;
    max-width: 38rem;
    font-size: clamp(1.1rem, 1rem + 0.45vw, 1.3rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .ctas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
    padding: 0;
  }

  .cta-note {
    margin-top: 0.75rem;
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  /* ---------- Hero scene: a camera feed from Mars ---------- */
  .scene-box {
    display: grid;
    justify-items: center;
  }

  .scene {
    position: relative;
    width: min(30rem, 100%);
    aspect-ratio: 1;
    overflow: hidden;
    /* the ground, the base, the rover and the signal are sized in cqw (scene width) and pinned
       to the bottom, so a taller scene on phones only adds sky for the tags */
    container-type: inline-size;
    border: 1px solid var(--border-hi);
    border-radius: var(--r-lg);
    background:
      radial-gradient(70% 38% at 78% 52%, color-mix(in srgb, var(--accent-2) 38%, transparent), transparent 70%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 30%, color-mix(in srgb, var(--brand) 55%, var(--bg)) 58%);
    box-shadow: var(--glow);
  }

  .stars {
    position: absolute;
    inset: 0 0 45%;
    background:
      radial-gradient(1.4px 1.4px at 12% 18%, var(--text) 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 34% 8%, var(--muted) 50%, transparent 51%),
      radial-gradient(1.6px 1.6px at 56% 22%, var(--text) 50%, transparent 51%),
      radial-gradient(1px 1px at 72% 40%, var(--muted) 50%, transparent 51%),
      radial-gradient(1.3px 1.3px at 90% 12%, var(--text) 50%, transparent 51%),
      radial-gradient(1px 1px at 22% 46%, var(--muted) 50%, transparent 51%),
      radial-gradient(1.2px 1.2px at 46% 60%, var(--muted) 50%, transparent 51%),
      radial-gradient(1px 1px at 84% 66%, var(--text) 50%, transparent 51%);
    animation: twinkle 5s ease-in-out infinite;
  }

  @keyframes twinkle {
    50% {
      opacity: 0.45;
    }
  }

  /* Phobos and Deimos */
  .moon-a,
  .moon-b {
    position: absolute;
    border-radius: 46% 54% 50% 50%;
    background: radial-gradient(circle at 35% 30%, var(--hl), var(--muted) 55%, var(--border-hi));
  }

  .moon-a {
    top: 7%;
    left: 47%;
    width: 7%;
    aspect-ratio: 1.15;
    box-shadow: 0 0 24px -4px color-mix(in srgb, var(--hl) 50%, transparent);
  }

  .moon-b {
    top: 33%;
    left: 52%;
    width: 2.6%;
    aspect-ratio: 1;
    opacity: 0.8;
  }

  @media (max-width: 32.99rem) {
    .scene {
      aspect-ratio: 4 / 5;
    }

    /* the label may be wider than the dome: keep it inside the frame (outranks the base rule below) */
    .scene .base {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }
  }

  .ground {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 55cqw;
  }

  .dune-far {
    fill: color-mix(in srgb, var(--brand) 70%, var(--bg));
  }

  .dune-mid {
    fill: var(--brand);
  }

  .dune-near {
    fill: color-mix(in srgb, var(--brand-hi) 55%, var(--bg));
  }

  .crater {
    fill: color-mix(in srgb, var(--bg) 35%, transparent);
  }

  .rock {
    fill: color-mix(in srgb, var(--bg) 45%, var(--brand));
  }

  .tracks {
    fill: none;
    stroke: color-mix(in srgb, var(--bg) 40%, transparent);
    stroke-width: 7;
    stroke-dasharray: 3 5;
  }

  /* rover antenna → base: the line stays open */
  .signal {
    position: absolute;
    inset: auto 0 0;
    width: 100%;
    height: 100cqw;
    overflow: visible;
  }

  .signal path {
    fill: none;
    stroke: var(--hl);
    stroke-width: 2;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    opacity: 0.85;
    animation: signal 1.2s linear infinite;
  }

  @keyframes signal {
    to {
      stroke-dashoffset: -18;
    }
  }

  /* "your company" is the base the rover works for */
  .base {
    position: absolute;
    right: 5cqw;
    bottom: 34cqw;
    width: 34cqw;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
  }

  .base svg {
    width: 100%;
    overflow: visible;
  }

  .base-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--hl) 55%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    font: 700 clamp(0.68rem, 2.7cqw, 0.82rem) / 1.2 var(--font-display);
    color: var(--text);
    white-space: nowrap;
  }

  .base-tag :global(.icon) {
    color: var(--hl);
  }

  .base-glass {
    fill: color-mix(in srgb, var(--mint) 14%, transparent);
    stroke: var(--hl);
    stroke-width: 2;
  }

  .base-grid {
    fill: none;
    stroke: color-mix(in srgb, var(--hl) 40%, transparent);
    stroke-width: 1.2;
  }

  .base-floor {
    fill: var(--muted);
    stroke: var(--bg);
    stroke-width: 2;
  }

  .base-door {
    fill: var(--accent-2);
    stroke: var(--bg);
    stroke-width: 2;
  }

  .base-mast {
    stroke: var(--muted);
    stroke-width: 2;
  }

  .base-light {
    fill: var(--accent-2);
    animation: beacon 2s steps(1) infinite;
  }

  @keyframes beacon {
    50% {
      fill: var(--hl);
    }
  }

  .scene-rover {
    position: absolute;
    left: 3cqw;
    bottom: 3cqw;
    width: 46cqw;
  }

  /* the kinds of work float in the sky, two per row */
  .tags {
    position: absolute;
    inset: 5% 4% auto;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 0.6rem;
    padding: 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--border-hi);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-2) 88%, transparent);
    font: 500 clamp(0.62rem, 2.5cqw, 0.76rem) / 1.2 var(--font-mono);
    color: var(--text);
    white-space: nowrap;
    animation: drift 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -1.1s);
  }

  /* wide scenes: two per row, staggered like a loose constellation */
  @media (min-width: 33rem) {
    .tags {
      display: grid;
      grid-template-columns: repeat(2, max-content);
    }

    .tag {
      justify-self: start;
    }

    .tag:nth-child(even) {
      justify-self: end;
      margin-top: 0.7rem;
    }

    .tag:nth-child(3) {
      margin-left: 6cqw;
    }

    .tag:nth-child(4) {
      margin-right: 4cqw;
    }

    .tag:nth-child(5) {
      margin-left: 1.5cqw;
    }
  }

  .tag :global(.icon) {
    color: var(--accent);
  }

  @keyframes drift {
