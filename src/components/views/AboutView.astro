---
/**
 * About: photo + intro (src/content/pages/about/<lang>.md body) → story cards
 * (frontmatter `story`) → experience (cards, details folded) → skills (chip groups)
 * → education + languages → contact. Facts come from src/data/profile.ts.
 */
import { getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../SectionHeading.astro';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../ui/Icon.astro';
import photo from '../../assets/bruno-anhezini.jpg';
import { formatMonth, l10n, profile } from '../../data/profile';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const entry = await getEntry('about', lang);
if (!entry) throw new Error(`[about] Missing src/content/pages/about/${lang}.md`);
const { Content } = await render(entry);
const { title, description, story } = entry.data;
const c = profile.contact;

/** "C#, .NET 8/9 e PrimeNG." → ["C#", ".NET 8/9", "PrimeNG"] */
const splitItems = (text: string) =>
  text
    .replace(/\.$/, '')
    .split(/,\s*|\s+(?:e|and)\s+/)
    .map((x) => x.trim())
    .filter(Boolean);
---

<BaseLayout lang={lang} title={title} description={description} ref={{ kind: 'page', page: 'about' }} ogType="profile">
  <div class="wrap">
    <header class="about-hero">
      <div class="photo">
        <span class="ring" aria-hidden="true"><span class="moon"></span></span>
        <Picture
          src={photo}
          alt={t(lang, 'about.photoAlt')}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={480}
          height={480}
          widths={[240, 360, 480]}
          sizes="(min-width: 48rem) 15rem, 11rem"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div>
        <p class="kicker"><Icon name="user" size={15} />{t(lang, 'about.kicker')}</p>
        <h1>{title}</h1>
        <div class="intro">
          <Content />
        </div>
        <p class="chips">
          <span class="chip"><Icon name="map-pin" size={13} />{profile.location[lang]}</span>
          <span class="chip chip-mint"><span class="pulse" aria-hidden="true"></span>{profile.lookingFor[lang]}</span>
        </p>
      </div>
    </header>
  </div>

  {
    story.length > 0 && (
      <section class="section" aria-labelledby="story-title">
        <div class="wrap">
          <SectionHeading id="story-title" kicker={t(lang, 'about.storyKicker')} icon="orbit">
            {t(lang, 'about.story')}
          </SectionHeading>
          <ol class="story">
            {story.map((s) => (
              <li class="card story-card reveal">
                <span class="story-icon" aria-hidden="true">
                  <Icon name={s.icon} size={22} />
                </span>
                <p class="chip chip-accent">{s.when}</p>
                <h3>{s.title}</h3>
                <p class="story-text">{s.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="experience-title">
    <div class="wrap">
      <SectionHeading id="experience-title" kicker={t(lang, 'about.expKicker')} icon="briefcase">
        {t(lang, 'about.experience')}
      </SectionHeading>
      <ol class="jobs">
        {
          profile.experience.map((job, i) => (
            <li class:list={['card', 'job', 'reveal', { 'is-current': !job.end || i === 0 }]}>
              <div class="job-head">
                <span class="job-node" aria-hidden="true" />
                <div>
                  <h3>
                    {job.role[lang]}
                    <span class="at">
                      <span aria-hidden="true">@</span>
                      <span class="sr-only">, </span>
                      {job.company}
                    </span>
                  </h3>
                  <p class="job-meta">
                    <span class="chip">
                      <Icon name="clock" size={13} />
                      <time datetime={job.start}>{formatMonth(lang, job.start)}</time>&nbsp;–&nbsp;
                      {job.end ? <time datetime={job.end}>{formatMonth(lang, job.end)}</time> : t(lang, 'about.present')}
                    </span>
                    <span class="chip">
                      <Icon name="map-pin" size={13} />
                      {job.location[lang]}
                    </span>
                    <span class="chip">{job.mode[lang]}</span>
                  </p>
                </div>
              </div>
              <ul class="tag-list" aria-label={t(lang, 'about.tech')}>
                {job.tech.map((x) => (
                  <li class="chip chip-accent">{l10n(x, lang)}</li>
                ))}
              </ul>
              <details class="job-details">
                <summary>
                  <Icon name="arrow-right" size={15} class="caret-icon" />
                  {t(lang, 'about.details')}
                </summary>
                <ul class="highlights">
                  {job.highlights.map((h) => (
                    <li>{h[lang]}</li>
                  ))}
                </ul>
              </details>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="skills-title">
    <div class="wrap">
      <SectionHeading id="skills-title" kicker={t(lang, 'about.skillsKicker')} icon="layers">
        {t(lang, 'about.skills')}
      </SectionHeading>
      <div class="skills">
        {
          profile.skills.map((g) => (
            <section class="card skill-card reveal" aria-label={g.name[lang]}>
              <h3>{g.name[lang]}</h3>
              <ul class="tag-list">
                {splitItems(g.items[lang]).map((x) => (
                  <li class="chip">{x}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="more-title">
    <div class="wrap">
      <SectionHeading id="more-title" kicker={t(lang, 'about.moreKicker')} icon="graduation-cap">
        {t(lang, 'about.education')} & {t(lang, 'about.languages')}
      </SectionHeading>
      <div class="two">
        {
          profile.education.map((ed) => (
            <div class="card info-card reveal">
              <span class="story-icon" aria-hidden="true">
                <Icon name="graduation-cap" size={22} />
              </span>
              <h3>{ed.degree[lang]}</h3>
              <p class="inst">{ed.institution}</p>
              <p class="chips">
                <span class="chip chip-accent">{ed.completed[lang]}</span>
                <span class="chip">
                  <Icon name="map-pin" size={13} />
                  {ed.location[lang]}
                </span>
              </p>
              <p class="note">{ed.note[lang]}</p>
            </div>
          ))
        }
        <div class="card info-card reveal">
          <span class="story-icon" aria-hidden="true"><Icon name="languages" size={22} /></span>
          <h3>{t(lang, 'about.languages')}</h3>
          <ul class="langs">
            {
              profile.languages.map((l, i) => (
                <li>
                  <span>{l.name[lang]}</span>
                  <span class="meter" aria-hidden="true">
                    <span style={`width:${[100, 66, 33][i] ?? 33}%`} />
                  </span>
                  <span class="chip">{l.level[lang]}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="wrap">
      <SectionHeading id="contact-title" kicker={t(lang, 'about.contactKicker')} icon="message">
        {t(lang, 'about.contact')}
      </SectionHeading>
      <ul class="contacts">
        <li class="card contact-card main-contact">
          <Icon name="linkedin" size={22} class="c-icon" />
          <span class="c-k">{t(lang, 'about.linkedin')}</span>
          <ExternalLink class="c-v" href={c.linkedin} lang={lang}>linkedin.com/{c.linkedinHandle}</ExternalLink>
        </li>
        <li class="card contact-card">
          <Icon name="github" size={22} class="c-icon" />
          <span class="c-k">{t(lang, 'about.github')}</span>
          <ExternalLink class="c-v" href={c.github} lang={lang}>github.com/{c.githubHandle}</ExternalLink>
        </li>
        <li class="card contact-card">
          <Icon name="phone" size={22} class="c-icon" />
          <span class="c-k">{t(lang, 'about.phone')}</span>
          <span class="c-v">
            <a href={`tel:${c.phoneE164}`}>{c.phoneDisplay}</a>
            <ExternalLink href={c.whatsapp} lang={lang}>WhatsApp</ExternalLink>
          </span>
        </li>
        <li class="card contact-card">
          <Icon name="mail" size={22} class="c-icon" />
          <span class="c-k">{t(lang, 'about.email')}</span>
          <a class="c-v" href={`mailto:${c.email}`}>{c.email}</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .about-hero {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  @media (min-width: 48rem) {
    .about-hero {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3rem;
    }
  }

  .photo {
    position: relative;
    width: 11rem;
    aspect-ratio: 1;
  }

  @media (min-width: 48rem) {
    .photo {
      width: 15rem;
    }
  }

  .photo :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--bg);
    box-shadow:
      0 0 0 2px var(--brand-hi),
      0 0 60px -10px rgb(124 77 255 / 0.7);
  }

  .ring {
    position: absolute;
    inset: -14px;
    border: 1px dashed rgb(94 234 212 / 0.4);
    border-radius: 50%;
    animation: spin 18s linear infinite;
  }

  .moon {
    position: absolute;
    top: 50%;
    right: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--sun);
    box-shadow: 0 0 12px var(--sun);
  }

  .about-hero h1 {
    font-size: clamp(2.6rem, 1.6rem + 4vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .intro {
    margin-top: 0.9rem;
    max-width: 40rem;
    color: var(--muted);
  }

  .intro :global(p:first-child) {
    color: var(--text);
    font-size: 1.15em;
  }

  .intro :global(p + p) {
    margin-top: 0.6rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .chips .chip {
    white-space: normal;
  }

  /* ---------- Story cards ---------- */
  .story {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .story-card,
  .info-card,
  .skill-card {
    gap: 0.6rem;
    padding: 1.25rem;
  }

  .story-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 0.35rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--brand), var(--brand-hi));
    color: #fff;
    transition: transform 300ms var(--ease-out);
  }

  .card:hover .story-icon {
    transform: rotate(-10deg) scale(1.08);
  }

  .story-card .chip {
    align-self: flex-start;
  }

  .story-card h3,
  .info-card h3,
  .skill-card h3 {
    font-size: 1.2rem;
  }

  .story-text {
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* ---------- Jobs ---------- */
  .jobs {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .job {
    gap: 1rem;
    padding: 1.25rem 1.35rem;
  }

  .job:hover {
    transform: translateY(-3px);
  }

  .job-head {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }

  .job-node {
    flex: none;
    width: 14px;
    height: 14px;
    margin-top: 0.45rem;
    border-radius: 50%;
    border: 2px solid var(--accent-2);
    background: var(--bg);
  }

  .is-current .job-node {
    background: var(--mint);
    border-color: var(--mint);
    box-shadow: 0 0 0 4px rgb(94 234 212 / 0.18);
  }

  .job h3 {
    font-size: clamp(1.2rem, 1.1rem + 0.5vw, 1.45rem);
  }

  .at {
    margin-left: 0.3em;
    color: var(--accent);
  }

  .skill-card .chip {
    white-space: normal;
  }

  .job-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.55rem;
  }

  .job-details summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    font-size: var(--fs-small);
    color: var(--accent);
  }

  .job-details summary::-webkit-details-marker {
    display: none;
  }

  .job-details summary :global(.caret-icon) {
    transition: transform 200ms var(--ease-out);
  }

  .job-details[open] summary :global(.caret-icon) {
    transform: rotate(90deg);
  }

  .highlights {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.2rem;
    color: #dcd7ea;
    font-size: var(--fs-small);
  }

  .highlights li::marker {
    content: '✦  ';
    color: var(--accent-2);
  }

  /* ---------- Skills ---------- */
  .skills {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }

  /* ---------- Education + languages ---------- */
  .two {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  .inst {
    color: var(--accent);
    font-weight: 600;
  }

  .note {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .langs {
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }

  .langs li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .meter {
    height: 6px;
    border-radius: 6px;
    background: var(--surface-2);
    overflow: hidden;
  }

  .meter span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--brand-hi), var(--mint));
  }

  /* ---------- Contact ---------- */
  .contacts {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }

  .contact-card {
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
  }

  .main-contact {
    border-color: var(--border-hi);
    background: linear-gradient(160deg, rgb(73 0 199 / 0.35), var(--surface));
  }

  .contact-card :global(.c-icon) {
    color: var(--mint);
    margin-bottom: 0.35rem;
  }

  .c-k {
    font: 500 var(--fs-meta) / 1.4 var(--font-mono);
    color: var(--muted);
  }

  .c-v,
  .c-v :global(a) {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .c-v {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
