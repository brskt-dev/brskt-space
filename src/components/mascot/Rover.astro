---
/**
 * The Dev parceiro mascot: a small Mars rover with a screen for a face, one mechanical arm
 * and an antenna. Inline SVG, decorative (aria-hidden): it never carries information.
 *
 * - `pose` moves the arm and adds props: wave, point (at whatever is to its right), build
 *   (wrench + sparks), scan (magnifier), flag (planting a flag), think (hand on the chin,
 *   thought dots), drive (speed lines, rolling treads), rest.
 * - `mood` changes the face on the screen: neutral, happy, curious, focused, excited,
 *   thinking, wink.
 * - `size` is the CSS width (height follows the viewBox).
 *
 * Colours are the page tokens, so it takes the palette of the planet it sits on (it was
 * drawn for `.planet-mars`). Motion is CSS only and stops under prefers-reduced-motion
 * (global rule in global.css).
 */
export type RoverPose = 'rest' | 'wave' | 'point' | 'build' | 'scan' | 'flag' | 'think' | 'drive';
export type RoverMood = 'neutral' | 'happy' | 'curious' | 'focused' | 'excited' | 'thinking' | 'wink';

interface Props {
  pose?: RoverPose;
  mood?: RoverMood;
  size?: string;
  flip?: boolean;
  class?: string;
}

const { pose = 'rest', mood = 'neutral', size = '8rem', flip = false, class: cls } = Astro.props;

// Arm geometry per pose: shoulder → elbow → hand, and the angle the gripper points to.
const shoulder = { x: 138, y: 122 };
const arms: Record<RoverPose, { e: [number, number]; h: [number, number]; a: number }> = {
  rest: { e: [156, 138], h: [166, 156], a: 62 },
  drive: { e: [156, 138], h: [166, 156], a: 62 },
  wave: { e: [162, 106], h: [170, 76], a: -78 },
  point: { e: [160, 114], h: [190, 104], a: -18 },
  build: { e: [162, 112], h: [176, 92], a: -55 },
  scan: { e: [162, 112], h: [178, 94], a: -45 },
  flag: { e: [158, 110], h: [168, 88], a: -70 },
  think: { e: [158, 112], h: [137, 84], a: -130 },
};
const arm = arms[pose];
const [ex, ey] = arm.e;
const [hx, hy] = arm.h;
const tilt: Partial<Record<RoverPose, number>> = { think: -6, scan: 5, wave: -3, point: 3 };
const headTilt = tilt[pose] ?? 0;
---

<svg
  class:list={['rover', `rover-${pose}`, `rover-${mood}`, { 'rover-flip': flip }, cls]}
  style={`--rv-size:${size}`}
  viewBox="0 -10 220 208"
  aria-hidden="true"
  focusable="false"
>
  <ellipse class="rv-shadow" cx="95" cy="190" rx="72" ry="6"></ellipse>

  {
    pose === 'drive' && (
      <g class="rv-speed">
        <path d="M2 128h16M8 144h12M0 160h16" />
      </g>
    )
  }

  {
    pose === 'think' && (
      <g class="rv-dots">
        <circle cx="152" cy="18" r="3" />
        <circle cx="163" cy="7" r="4" />
        <circle cx="177" cy="-3" r="5" />
      </g>
    )
  }

  {
    pose === 'flag' && (
      <g class="rv-flag">
        <path class="rv-pole" d="M172 128V14" />
        <path class="rv-cloth" d="M172 14h30l-7 10 7 10h-30z" />
      </g>
    )
  }

  <g class="rv-body">
    <!-- solar panels, behind the chassis -->
    <path class="rv-panel" d="M30 96l34-6v14l-38 6zM126 90l34 6 4 14-38-6z"></path>
    <path class="rv-panel-line" d="M47 94l-2 14M143 94l2 14"></path>

    <!-- rear wheels -->
    <rect class="rv-wheel-back" x="34" y="122" width="24" height="46" rx="10"></rect>
    <rect class="rv-wheel-back" x="132" y="122" width="24" height="46" rx="10"></rect>

    <!-- chassis -->
    <rect class="rv-shell" x="54" y="100" width="82" height="56" rx="14"></rect>
    <rect class="rv-shade" x="58" y="141" width="74" height="12" rx="8"></rect>
    <rect class="rv-plate" x="68" y="112" width="54" height="22" rx="6"></rect>
    <circle class="rv-led rv-led-1" cx="79" cy="123" r="3"></circle>
    <circle class="rv-led rv-led-2" cx="89" cy="123" r="3"></circle>
    <circle class="rv-led rv-led-3" cx="99" cy="123" r="3"></circle>
    <rect class="rv-vent" x="106" y="119" width="10" height="8" rx="2"></rect>

    <!-- struts + front wheels -->
    <rect class="rv-strut" x="48" y="139" width="12" height="7" rx="2"></rect>
    <rect class="rv-strut" x="130" y="139" width="12" height="7" rx="2"></rect>
    <rect class="rv-wheel" x="22" y="134" width="30" height="52" rx="12"></rect>
    <rect class="rv-wheel" x="138" y="134" width="30" height="52" rx="12"></rect>
    <path class="rv-tread" d="M37 140v40M153 140v40"></path>
    <rect class="rv-hub" x="31" y="154" width="12" height="12" rx="3"></rect>
    <rect class="rv-hub" x="147" y="154" width="12" height="12" rx="3"></rect>

    <!-- neck -->
    <rect class="rv-neck" x="89" y="76" width="12" height="26" rx="3"></rect>
    <rect class="rv-collar" x="84" y="95" width="22" height="7" rx="3.5"></rect>

    <!-- head -->
    <g class="rv-head" style={`--tilt:${headTilt}deg`}>
      <path class="rv-mast" d="M118 22l10-20"></path>
      <circle class="rv-beacon" cx="129" cy="1" r="4.5"></circle>
      <rect class="rv-visor" x="70" y="13" width="50" height="9" rx="4"></rect>
      <rect class="rv-ear" x="46" y="40" width="9" height="20" rx="4"></rect>
      <rect class="rv-ear" x="135" y="40" width="9" height="20" rx="4"></rect>
      <rect class="rv-shell" x="53" y="20" width="84" height="62" rx="16"></rect>
      <rect class="rv-screen" x="62" y="29" width="66" height="44" rx="10"></rect>
      <path class="rv-glare" d="M68 38v-2.5a3 3 0 0 1 3-3h9"></path>

      <g class="rv-face">
        {
          mood === 'neutral' && (
            <>
              <g class="rv-eyes">
                <rect x="77" y="43" width="8" height="12" rx="3" />
                <rect x="105" y="43" width="8" height="12" rx="3" />
              </g>
              <path class="rv-line" d="M89 62q6 4 12 0" />
            </>
          )
        }
        {
          mood === 'happy' && (
            <>
              <path class="rv-line rv-thick" d="M75 52q6-9 12 0M103 52q6-9 12 0" />
              <path class="rv-line" d="M87 60q8 8 16 0" />
            </>
          )
        }
        {
          mood === 'curious' && (
            <>
              <g class="rv-eyes">
                <rect x="77" y="44" width="8" height="12" rx="3" />
                <rect x="103.5" y="42" width="11" height="15" rx="4" />
              </g>
              <path class="rv-line" d="M102 38l13-4" />
              <circle class="rv-line" cx="95" cy="63" r="2.6" />
            </>
          )
        }
        {
          mood === 'focused' && (
            <>
              <g class="rv-eyes">
                <rect x="75" y="48" width="12" height="4.5" rx="2" />
                <rect x="103" y="48" width="12" height="4.5" rx="2" />
              </g>
              <path class="rv-line" d="M74 42l12 3M116 42l-12 3M90 62h10" />
            </>
          )
        }
        {
          mood === 'excited' && (
            <>
              <g class="rv-eyes">
                <rect x="76" y="40" width="10" height="15" rx="4" />
                <rect x="104" y="40" width="10" height="15" rx="4" />
              </g>
              <rect class="rv-spark-eye" x="78" y="42" width="3" height="3" rx="1" />
              <rect class="rv-spark-eye" x="106" y="42" width="3" height="3" rx="1" />
              <path class="rv-mouth" d="M87 59h16q0 8-8 8t-8-8z" />
            </>
          )
        }
        {
          mood === 'thinking' && (
            <>
              <g class="rv-eyes">
                <rect x="80" y="39" width="8" height="10" rx="3" />
                <rect x="108" y="39" width="8" height="10" rx="3" />
              </g>
              <path class="rv-line" d="M90 63l10-2.5" />
            </>
          )
        }
        {
          mood === 'wink' && (
            <>
              <path class="rv-line rv-thick" d="M75 51q6-8 12 0" />
              <g class="rv-eyes">
                <rect x="105" y="43" width="8" height="12" rx="3" />
              </g>
              <path class="rv-line" d="M87 60q8 7 16 0" />
            </>
          )
        }
      </g>
    </g>

    <!-- arm: upper arm, then the forearm group (it moves around the elbow) -->
    <path class="rv-arm-out" d={`M${shoulder.x} ${shoulder.y}L${ex} ${ey}`}></path>
    <path class="rv-arm-in" d={`M${shoulder.x} ${shoulder.y}L${ex} ${ey}`}></path>
    <g class="rv-fore" style={`transform-origin:${ex}px ${ey}px`}>
      <path class="rv-arm-out" d={`M${ex} ${ey}L${hx} ${hy}`}></path>
      <path class="rv-arm-in" d={`M${ex} ${ey}L${hx} ${hy}`}></path>
      <g transform={`translate(${hx} ${hy}) rotate(${arm.a})`}>
        {
          pose === 'build' && (
            <g class="rv-tool">
              <path class="rv-tool-out" d="M4 0h20" />
              <path class="rv-tool-in" d="M4 0h20" />
              <circle class="rv-wrench" cx="29" cy="0" r="8" />
              <rect class="rv-notch" x="30" y="-3.2" width="10" height="6.4" rx="1.5" />
            </g>
          )
        }
        {
          pose === 'scan' && (
            <g class="rv-tool">
              <path class="rv-tool-out" d="M4 0h8" />
              <path class="rv-tool-in" d="M4 0h8" />
              <circle class="rv-lens" cx="22" cy="0" r="10" />
              <path class="rv-lens-glare" d="M16 -3a6.5 6.5 0 0 1 5-4.5" />
            </g>
          )
        }
        <path class="rv-claw" d="M2 0l8-6M2 0l8 6"></path>
        <circle class="rv-joint" cx="0" cy="0" r="4"></circle>
      </g>
      <circle class="rv-joint" cx={ex} cy={ey} r="4.5"></circle>
    </g>
    <circle class="rv-joint rv-shoulder" cx={shoulder.x} cy={shoulder.y} r="6"></circle>
  </g>

  {
    pose === 'build' && (
      <g class="rv-sparks">
        <path d="M206 58l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" />
        <path d="M190 46l1.4 3.5 3.5 1.4-3.5 1.4-1.4 3.5-1.4-3.5-3.5-1.4 3.5-1.4z" />
      </g>
    )
  }
</svg>

<style>
  .rover {
    display: block;
    width: var(--rv-size);
    height: auto;
    overflow: visible;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .rover-flip {
    transform: scaleX(-1);
  }

  .rv-shadow {
    fill: color-mix(in srgb, var(--bg) 70%, transparent);
  }

  .rv-shell {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 3;
  }

  .rv-shade {
    fill: color-mix(in srgb, var(--muted) 60%, transparent);
  }

  .rv-panel {
    fill: var(--brand-hi);
    stroke: var(--bg);
    stroke-width: 3;
  }

  .rv-panel-line {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2;
  }

  .rv-plate {
    fill: var(--surface-2);
    stroke: var(--bg);
    stroke-width: 3;
  }

  .rv-wheel {
    fill: var(--border);
    stroke: var(--bg);
    stroke-width: 3;
  }

  .rv-wheel-back {
    fill: var(--surface-2);
    stroke: var(--bg);
    stroke-width: 3;
  }

  /* a thick dashed line draws the tread bars; moving the dash rolls the wheel */
  .rv-tread {
    fill: none;
    stroke: var(--border-hi);
    stroke-width: 20;
    stroke-linecap: butt;
    stroke-dasharray: 3 5;
  }

  .rv-hub,
  .rv-ear,
  .rv-collar {
    fill: var(--accent-2);
    stroke: var(--bg);
    stroke-width: 2.5;
  }

  .rv-strut,
  .rv-neck,
  .rv-visor {
    fill: var(--muted);
    stroke: var(--bg);
    stroke-width: 2.5;
  }

  .rv-vent {
    fill: var(--border-hi);
  }

  .rv-led-1 {
    fill: var(--accent-2);
  }

  .rv-led-2 {
    fill: var(--hl);
  }

  .rv-led-3 {
    fill: var(--mint);
  }

  .rv-mast {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
  }

  .rv-beacon {
    fill: var(--accent-2);
    stroke: var(--bg);
    stroke-width: 2;
  }

  .rv-head {
    transform-box: view-box;
    transform-origin: 95px 80px;
    transform: rotate(var(--tilt));
  }

  .rv-screen {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 2;
  }

  .rv-glare {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 35%, transparent);
    stroke-width: 2.5;
  }

  /* the face glows on the screen */
  .rv-face {
    color: var(--mint);
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--mint) 55%, transparent));
  }

  .rv-eyes,
  .rv-mouth {
    fill: currentColor;
  }

  .rv-line {
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
  }

  .rv-thick {
    stroke-width: 4;
  }

  .rv-spark-eye {
    fill: var(--bg);
  }

  .rv-arm-out,
  .rv-tool-out {
    fill: none;
    stroke: var(--bg);
    stroke-width: 11;
  }

  .rv-arm-in {
    fill: none;
    stroke: var(--muted);
    stroke-width: 6.5;
  }

  .rv-tool-in {
    fill: none;
    stroke: var(--text);
    stroke-width: 5;
  }

  .rv-joint {
    fill: var(--accent-2);
    stroke: var(--bg);
    stroke-width: 2.5;
  }

  .rv-claw {
    fill: none;
    stroke: var(--text);
    stroke-width: 4;
    filter: drop-shadow(0 0 0.5px var(--bg));
  }

  .rv-wrench {
    fill: var(--text);
    stroke: var(--bg);
    stroke-width: 2.5;
  }

  .rv-notch {
    fill: var(--bg);
  }

  .rv-lens-glare {
    fill: none;
    stroke: color-mix(in srgb, var(--text) 70%, transparent);
    stroke-width: 2.2;
  }

  .rv-lens {
    fill: color-mix(in srgb, var(--mint) 18%, transparent);
    stroke: var(--text);
    stroke-width: 4;
  }

  .rv-pole {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3.5;
  }

  .rv-cloth {
    fill: var(--accent-2);
    stroke: var(--bg);
    stroke-width: 2.5;
    transform-box: fill-box;
    transform-origin: left center;
  }

  .rv-dots circle {
    fill: var(--muted);
  }

  .rv-speed path {
    fill: none;
    stroke: var(--border-hi);
    stroke-width: 3.5;
    stroke-dasharray: 10 6;
  }

  .rv-sparks path {
    fill: var(--sun);
  }

  /* ---------- motion (all of it stops under prefers-reduced-motion) ---------- */
  .rv-body {
    animation: rv-bob 3.6s ease-in-out infinite;
  }

  .rv-beacon {
    animation: rv-blink 2.4s steps(1) infinite;
  }

  .rv-eyes {
    transform-box: view-box;
    transform-origin: 95px 49px;
    animation: rv-eyes 6s ease-in-out infinite;
  }

  .rv-led-1 {
    animation: rv-led 3s steps(1) infinite;
  }

  .rv-led-2 {
    animation: rv-led 3s steps(1) 1s infinite;
  }

  .rv-led-3 {
    animation: rv-led 3s steps(1) 2s infinite;
  }

  .rv-fore {
    transform-box: view-box;
  }

  .rover-wave .rv-fore {
    animation: rv-wave 1.8s ease-in-out infinite;
  }

  .rover-scan .rv-fore {
    animation: rv-scan 3.2s ease-in-out infinite;
  }

  .rover-point .rv-fore {
    animation: rv-poke 2.2s ease-in-out infinite;
  }

  .rover-build .rv-fore {
    animation: rv-turn 1.4s ease-in-out infinite;
  }

  .rv-sparks path {
    animation: rv-spark 1.4s steps(1) infinite;
  }

  .rv-sparks path + path {
    animation-delay: 0.7s;
  }

  .rv-cloth {
    animation: rv-cloth 2.4s ease-in-out infinite;
  }

  .rv-dots circle {
    animation: rv-dot 2.4s ease-in-out infinite;
  }

  .rv-dots circle:nth-child(2) {
    animation-delay: 0.3s;
  }

  .rv-dots circle:nth-child(3) {
    animation-delay: 0.6s;
  }

  .rover-drive .rv-body {
    animation-duration: 0.9s;
  }

  .rover-drive .rv-tread {
    animation: rv-roll 0.6s linear infinite;
  }

  .rv-speed path {
    animation: rv-dash 0.8s linear infinite;
  }

  @keyframes rv-bob {
    50% {
      transform: translateY(-2.5px);
    }
  }

  @keyframes rv-blink {
    50% {
      fill: var(--hl);
    }
  }

  @keyframes rv-eyes {
    0%,
    46%,
    50%,
    100% {
      transform: none;
    }
    48% {
      transform: scaleY(0.1);
    }
  }

  @keyframes rv-led {
    0%,
    66% {
      opacity: 1;
    }
    33% {
      opacity: 0.3;
    }
  }

  @keyframes rv-wave {
    50% {
      transform: rotate(-22deg);
    }
  }

  @keyframes rv-scan {
    50% {
      transform: rotate(14deg);
    }
  }

  @keyframes rv-poke {
    50% {
      transform: translateX(4px);
    }
  }

  @keyframes rv-turn {
    50% {
      transform: rotate(-12deg);
    }
  }

  @keyframes rv-spark {
    50% {
      opacity: 0;
    }
  }

  @keyframes rv-cloth {
    50% {
      transform: skewY(-6deg) scaleX(0.92);
    }
  }

  @keyframes rv-dot {
    0%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes rv-roll {
    to {
      stroke-dashoffset: -8;
    }
  }

  @keyframes rv-dash {
    to {
      stroke-dashoffset: 16;
    }
  }
</style>
