---
/** Margin-annotation style metadata: "tipo: produto · status: ○ em desenvolvimento · publicado: 1 out. 2026". */
import { formatDate, isoDate, statusLabel, t, typeLabel, type Lang, type PublicationType } from '../i18n/ui';

interface Props {
  lang: Lang;
  type: PublicationType;
  status?: string;
  date?: Date;
  updated?: Date;
  /** Show "key: value" pairs (true) or values only (false, compact cards). */
  keys?: boolean;
  class?: string;
}

const { lang, type, status, date, updated, keys = true, class: className } = Astro.props;

const parts: { k: string; v: string; datetime?: string; status?: string }[] = [
  { k: t(lang, 'meta.type'), v: typeLabel(lang, type) },
];
if (status) parts.push({ k: t(lang, 'meta.status'), v: statusLabel(lang, status), status });
if (date) parts.push({ k: t(lang, 'meta.date'), v: formatDate(lang, date), datetime: isoDate(date) });
if (updated) parts.push({ k: t(lang, 'meta.updated'), v: formatDate(lang, updated), datetime: isoDate(updated) });
---

<p class:list={['annot', 'pub-meta', className]}>
  {
    parts.map((p) => (
      <span class="pair">
        <span class="sep" aria-hidden="true">
          ·
        </span>
        {keys && <span class="k">{p.k}: </span>}
        {p.status && <span class="status-glyph" data-status={p.status} aria-hidden="true" />}
        {p.datetime ? (
          <time class="v" datetime={p.datetime}>
            {p.v}
          </time>
        ) : (
          <span class="v">{p.v}</span>
        )}
      </span>
    ))
  }
</p>

<style>
  /* Every pair carries a leading "·" of fixed width; the line is shifted left by that
     width and clipped, so the separator that would start a line (incl. the first) is
     hidden and no line ever ends on a dangling "·". Non-interactive content only
     (a focus ring would be clipped). */
  .pub-meta {
    --meta-sep: 1.6em;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    row-gap: 0.1rem;
    margin-left: calc(-1 * var(--meta-sep));
    clip-path: inset(-0.5em 0 -0.5em var(--meta-sep));
  }

  .pair {
    white-space: nowrap;
  }

  .pub-meta .sep {
    display: inline-block;
    width: var(--meta-sep);
    padding: 0;
    text-align: center;
  }
</style>
