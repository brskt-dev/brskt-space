---
/**
 * A publication as a card: cover (real `cover:` image or generated space art),
 * type + status chips, title (the whole card is the link), summary, tags.
 */
import { Image } from 'astro:assets';
import Cover from './ui/Cover.astro';
import Icon, { type IconName } from './ui/Icon.astro';
import { publicationUrl, statusLabel, t, typeLabel, type Lang, type PublicationType } from '../i18n/ui';
import type { Publication } from '../lib/publications';
import { readingMinutes } from '../lib/reading-time';

interface Props {
  lang: Lang;
  pub: Publication;
  headingLevel?: 2 | 3;
}

const { lang, pub, headingLevel = 3 } = Astro.props;
const data = pub.entries[lang].data;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const href = publicationUrl(lang, pub.type, pub.slug);
const cardImage = data.thumbnail ?? data.cover;
const minutes = pub.type === 'article' ? readingMinutes(pub.entries[lang].body) : undefined;
const typeIcon: Record<PublicationType, IconName> = { product: 'package', article: 'file-text', experiment: 'flask' };
---

<article class="card pub-card reveal">
  <div class="card-media">
    {
      cardImage ? (
        <Image src={cardImage} alt="" widths={[400, 640, 800]} sizes="(min-width: 72rem) 18rem, (min-width: 40rem) 45vw, 100vw" />
      ) : (
        <Cover seed={pub.slug} kind={pub.type} />
      )
    }
    <span class="card-go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  </div>
  <div class="card-body">
    <p class="badges">
      <span class="chip chip-accent"><Icon name={typeIcon[pub.type]} size={13} />{typeLabel(lang, pub.type)}</span>
      {
        minutes && (
          <span class="chip">
            <Icon name="clock" size={13} />
            {t(lang, 'meta.readingTime').replace('{n}', String(minutes))}
          </span>
        )
      }
      {
        pub.status && (
          <span class="chip chip-mint">
            <span class="sr-only">{t(lang, 'meta.status')}: </span>
            <span class="pulse" aria-hidden="true" />
            {statusLabel(lang, pub.status)}
          </span>
        )
      }
    </p>
    <Heading class="card-title"><a class="card-link" href={href}>{data.title}</a></Heading>
    <p class="card-summary">{data.summary}</p>
    {
      data.tags.length > 0 && (
        <ul class="tag-list card-foot" aria-label={t(lang, 'pub.tags')}>
          {data.tags.map((tag) => (
            <li class="chip">#{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pub-card .chip-mint .pulse {
    width: 6px;
    height: 6px;
  }
</style>
