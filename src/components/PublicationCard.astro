---
/**
 * A publication in a list, set as an editorial ledger row: type + status as a margin
 * annotation, serif title (the whole row is the link), summary, tags.
 */
import PubMeta from './PubMeta.astro';
import { publicationUrl, type Lang } from '../i18n/ui';
import type { Publication } from '../lib/publications';

interface Props {
  lang: Lang;
  pub: Publication;
  headingLevel?: 2 | 3;
}

const { lang, pub, headingLevel = 3 } = Astro.props;
const data = pub.entries[lang].data;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const href = publicationUrl(lang, pub.type, pub.slug);
---

<article class="entry">
  <div class="entry-meta">
    <PubMeta lang={lang} type={pub.type} status={pub.status} keys={false} />
  </div>
  <div class="entry-main">
    <Heading class="entry-title"
      ><a class="entry-link" href={href}>{data.title}<span class="arrow" aria-hidden="true">→</span></a></Heading
    >
    <p class="summary">{data.summary}</p>
    {
      data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>
