---
/**
 * Site header: name (→ home of current language), main nav (sections only when they
 * have content), the Dev parceiro link (its own Mars-coloured pill, next to the language
 * switch, so it fits on phones without crowding the nav) and the language switch pointing
 * to the EQUIVALENT page.
 */
import Brand from './Brand.astro';
import Icon, { type IconName } from './ui/Icon.astro';
import {
  alternateUrl,
  htmlLang,
  otherLang,
  pathFor,
  sectionForType,
  t,
  type Lang,
  type PageKey,
  type PageRef,
} from '../i18n/ui';
import { getSectionAvailability } from '../lib/publications';

interface Props {
  lang: Lang;
  ref: PageRef;
}

const { lang, ref } = Astro.props;
const available = await getSectionAvailability();

const items: { key: PageKey; label: string; icon: IconName }[] = [
  { key: 'home', label: t(lang, 'nav.home'), icon: 'house' },
  ...(available.projects ? [{ key: 'projects' as const, label: t(lang, 'nav.projects'), icon: 'rocket' as const }] : []),
  ...(available.articles ? [{ key: 'articles' as const, label: t(lang, 'nav.articles'), icon: 'book-open' as const }] : []),
  { key: 'about', label: t(lang, 'nav.about'), icon: 'user' },
];

// Exact page → aria-current="page"; a publication marks its section with aria-current="true".
const currentFor = (key: PageKey): 'page' | 'true' | undefined => {
  if (ref.kind === 'page') return ref.page === key ? 'page' : undefined;
  const section = sectionForType(ref.type);
  return section === key ? 'true' : undefined;
};

const other = otherLang(lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <Brand href={pathFor(lang, 'home')} aria-label={t(lang, 'a11y.homeLink')} />

    <nav class="main-nav" aria-label={t(lang, 'a11y.mainNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={pathFor(lang, item.key)} aria-current={currentFor(item.key)}>
                <Icon name={item.icon} size={16} />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      class="dp-link planet-mars"
      href={pathFor(lang, 'devPartner')}
      aria-current={ref.kind === 'page' && ref.page === 'devPartner' ? 'page' : undefined}
    >
      <span class="dp-planet" aria-hidden="true"></span>
      <span>{t(lang, 'service.name')}</span>
    </a>

    <a class="lang-switch" href={alternateUrl(lang, ref)} hreflang={htmlLang[other]} lang={htmlLang[other]}>
      <Icon name="globe" size={16} />
      <span>{t(lang, 'a11y.switchLangShort')}</span>
      <span class="sr-only">, {t(lang, 'a11y.switchLang')}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas:
      'brand dp lang'
      'nav nav nav';
    align-items: center;
    column-gap: 0.5rem;
    padding-block: 0.4rem 0.5rem;
  }

  .header-inner > :global(.brand) {
    grid-area: brand;
    justify-self: start;
  }

  .main-nav {
    grid-area: nav;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    width: max-content;
    max-width: 100%;
  }

  .main-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    padding-inline: 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 550;
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 180ms var(--ease-out);
  }

  .main-nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .main-nav a:active {
    transform: scale(0.95);
  }

  .main-nav a[aria-current] {
    color: var(--on-brand);
    background: var(--btn-primary-bg);
  }

  /* Dev parceiro: a small Mars-coloured pill (the class swaps the palette tokens) */
  .dp-link {
    grid-area: dp;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap);
    padding-inline: 0.8rem 0.95rem;
    border: 1px solid var(--border-hi);
    border-radius: 999px;
    background: color-mix(in srgb, var(--brand) 22%, var(--bg));
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .dp-link:hover {
    border-color: var(--accent-2);
    background: color-mix(in srgb, var(--brand) 38%, var(--bg));
    color: var(--text);
  }

  .dp-link[aria-current] {
    border-color: transparent;
    background: var(--btn-primary-bg);
    color: var(--on-brand);
  }

  .dp-planet {
    flex: none;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, var(--hl), var(--accent-2) 45%, var(--brand) 100%);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--accent-2) 55%, transparent);
  }

  .dp-link:hover .dp-planet {
    animation: spin-once 700ms var(--ease-out);
  }

  @media (forced-colors: active) {
    .dp-link[aria-current] {
      border: 2px solid CanvasText;
    }
  }

  @media (forced-colors: active) {
    .main-nav a[aria-current] {
      border: 2px solid CanvasText;
    }
  }

  .lang-switch {
    grid-area: lang;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    padding-inline: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 600 var(--fs-meta) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .lang-switch:hover {
    background: var(--surface-2);
    border-color: var(--accent-2);
    color: var(--text);
  }

  .lang-switch:hover :global(.icon) {
    animation: spin-once 700ms var(--ease-out);
  }

  @keyframes spin-once {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 52rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto auto;
      grid-template-areas: 'brand nav dp lang';
      column-gap: 0.6rem;
      padding-block: 0.6rem;
    }

    .main-nav {
      margin-inline: 0.65rem;
    }

    .main-nav {
      justify-self: center;
    }
  }

  /* phones: four items must fit on one line, so drop the icons and tighten the pills */
  @media (max-width: 30rem) {
    .main-nav ul {
      flex-wrap: nowrap;
      gap: 0.1rem;
    }

    .main-nav a {
      padding-inline: 0.7rem;
      font-size: 0.875rem;
    }

    .main-nav a :global(.icon) {
      display: none;
    }
  }

  /* one-row header on tablets and small laptops: no room for the nav icons next to the pill */
  @media (min-width: 52rem) and (max-width: 74.99rem) {
    .main-nav a :global(.icon) {
      display: none;
    }

    .main-nav a {
      padding-inline: 0.75rem;
    }
  }

  /* phones: the brand, the Dev parceiro pill and the language switch share the first row */
  @media (max-width: 26rem) {
    .lang-switch :global(.icon) {
      display: none;
    }

    .lang-switch {
      padding-inline: 0.7rem;
    }

    .dp-link {
      padding-inline: 0.65rem 0.75rem;
      font-size: 0.82rem;
    }
  }

  @media (max-width: 22.5rem) {
    .main-nav a {
      padding-inline: 0.5rem;
      font-size: 0.8125rem;
    }

    .dp-link {
      gap: 0.35rem;
      padding-inline: 0.55rem 0.65rem;
      font-size: 0.78rem;
    }
  }

  /* very narrow phones (320px) */
  @media (max-width: 21rem) {
    .header-inner {
      column-gap: 0.3rem;
    }

    .dp-planet {
      display: none;
    }

    .lang-switch {
      padding-inline: 0.55rem;
    }
  }
</style>
