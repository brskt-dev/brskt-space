---
/**
 * Site header: name (→ home of current language), main nav (sections only when they
 * have content), and the language switch pointing to the EQUIVALENT page.
 */
import Brand from './Brand.astro';
import Icon, { type IconName } from './ui/Icon.astro';
import {
  alternateUrl,
  htmlLang,
  otherLang,
  pathFor,
  sectionForType,
  t,
  type Lang,
  type PageKey,
  type PageRef,
} from '../i18n/ui';
import { getSectionAvailability } from '../lib/publications';

interface Props {
  lang: Lang;
  ref: PageRef;
}

const { lang, ref } = Astro.props;
const available = await getSectionAvailability();

const items: { key: PageKey; label: string; icon: IconName }[] = [
  { key: 'home', label: t(lang, 'nav.home'), icon: 'house' },
  ...(available.projects ? [{ key: 'projects' as const, label: t(lang, 'nav.projects'), icon: 'rocket' as const }] : []),
  ...(available.articles ? [{ key: 'articles' as const, label: t(lang, 'nav.articles'), icon: 'book-open' as const }] : []),
  { key: 'about', label: t(lang, 'nav.about'), icon: 'user' },
];

// Exact page → aria-current="page"; a publication marks its section with aria-current="true".
const currentFor = (key: PageKey): 'page' | 'true' | undefined => {
  if (ref.kind === 'page') return ref.page === key ? 'page' : undefined;
  const section = sectionForType(ref.type);
  return section === key ? 'true' : undefined;
};

const other = otherLang(lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <Brand href={pathFor(lang, 'home')} aria-label={t(lang, 'a11y.homeLink')} />

    <nav class="main-nav" aria-label={t(lang, 'a11y.mainNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={pathFor(lang, item.key)} aria-current={currentFor(item.key)}>
                <Icon name={item.icon} size={16} />
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="lang-switch" href={alternateUrl(lang, ref)} hreflang={htmlLang[other]} lang={htmlLang[other]}>
      <Icon name="globe" size={16} />
      <span>{t(lang, 'a11y.switchLangShort')}</span>
      <span class="sr-only">, {t(lang, 'a11y.switchLang')}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(11 8 20 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgb(43 35 72 / 0.7);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.4rem 0.5rem;
  }

  .header-inner > :global(.brand) {
    grid-area: brand;
    justify-self: start;
  }

  .main-nav {
    grid-area: nav;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgb(21 16 38 / 0.6);
    width: max-content;
    max-width: 100%;
  }

  .main-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    padding-inline: 0.85rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 550;
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 180ms var(--ease-out);
  }

  .main-nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .main-nav a:active {
    transform: scale(0.95);
  }

  .main-nav a[aria-current] {
    color: #fff;
    background: linear-gradient(135deg, var(--brand), var(--brand-hi));
  }

  @media (forced-colors: active) {
    .main-nav a[aria-current] {
      border: 2px solid CanvasText;
    }
  }

  .lang-switch {
    grid-area: lang;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    padding-inline: 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font: 600 var(--fs-meta) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--accent);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .lang-switch:hover {
    background: var(--surface-2);
    border-color: var(--accent-2);
    color: var(--text);
  }

  .lang-switch:hover :global(.icon) {
    animation: spin-once 700ms var(--ease-out);
  }

  @keyframes spin-once {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 52rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav lang';
      column-gap: 1.25rem;
      padding-block: 0.6rem;
    }

    .main-nav {
      justify-self: center;
    }
  }

  /* phones: four items must fit on one line, so drop the icons and tighten the pills */
  @media (max-width: 30rem) {
    .main-nav ul {
      flex-wrap: nowrap;
      gap: 0.1rem;
    }

    .main-nav a {
      padding-inline: 0.7rem;
      font-size: 0.875rem;
    }

    .main-nav a :global(.icon) {
      display: none;
    }
  }

  @media (max-width: 22.5rem) {
    .main-nav a {
      padding-inline: 0.5rem;
      font-size: 0.8125rem;
    }
  }
</style>
