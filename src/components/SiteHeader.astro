---
/**
 * Site header: name (→ home of current language), main nav (sections only when they
 * have content), and the language switch pointing to the EQUIVALENT page.
 */
import { alternateUrl, htmlLang, otherLang, pathFor, t, type Lang, type PageKey, type PageRef } from '../i18n/ui';
import { getSectionAvailability } from '../lib/publications';

interface Props {
  lang: Lang;
  ref: PageRef;
}

const { lang, ref } = Astro.props;
const available = await getSectionAvailability();

const items: { key: PageKey; label: string }[] = [
  { key: 'home', label: t(lang, 'nav.home') },
  ...(available.projects ? [{ key: 'projects' as const, label: t(lang, 'nav.projects') }] : []),
  ...(available.articles ? [{ key: 'articles' as const, label: t(lang, 'nav.articles') }] : []),
  { key: 'about', label: t(lang, 'nav.about') },
];

// Exact page → aria-current="page"; a publication marks its section with aria-current="true".
const currentFor = (key: PageKey): 'page' | 'true' | undefined => {
  if (ref.kind === 'page') return ref.page === key ? 'page' : undefined;
  const section = ref.type === 'article' ? 'articles' : 'projects';
  return section === key ? 'true' : undefined;
};

const other = otherLang(lang);
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={pathFor(lang, 'home')} aria-label={t(lang, 'a11y.homeLink')}>
      <span class="brand-node" aria-hidden="true"></span>
      <span class="brand-name">Bruno Anhezini</span>
    </a>

    <nav class="main-nav" aria-label={t(lang, 'a11y.mainNav')}>
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={pathFor(lang, item.key)} aria-current={currentFor(item.key)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="lang-switch" href={alternateUrl(lang, ref)} hreflang={htmlLang[other]} lang={htmlLang[other]}>
      <span aria-hidden="true">{t(lang, 'a11y.switchLangShort')}</span>
      <span class="sr-only">{t(lang, 'a11y.switchLang')}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand lang'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.5rem 0.2rem;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: var(--tap);
    justify-self: start;
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand-name {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.012em;
    line-height: 1;
  }

  /* ──● mark */
  .brand-node {
    position: relative;
    width: 1.35rem;
    height: 10px;
    flex: none;
    background:
      radial-gradient(circle at calc(100% - 5px) 50%, var(--brand) 0 3.5px, var(--accent) 3.5px 4.75px, transparent 5.25px),
      linear-gradient(var(--brand-hi), var(--brand-hi)) left center / calc(100% - 8px) 1.5px no-repeat;
  }

  .main-nav {
    grid-area: nav;
    margin-inline: -0.65rem;
  }

  .main-nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    padding: 0;
  }

  .main-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding-inline: 0.65rem;
    color: var(--muted);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.005em;
    text-decoration: none;
  }

  .main-nav a:hover {
    color: var(--text);
  }

  .main-nav a[aria-current] {
    color: var(--text);
  }

  .main-nav a[aria-current]::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.5rem;
    height: 2px;
    border-radius: 2px;
    background: var(--brand-grad);
  }

  .lang-switch {
    grid-area: lang;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding-inline: 0.5rem;
    margin-right: -0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--accent);
    text-decoration: none;
  }

  .lang-switch:hover {
    color: var(--text);
  }

  .lang-switch span[aria-hidden] {
    padding-bottom: 0.1rem;
    border-bottom: 1px solid rgb(179 157 255 / 0.4);
  }

  .lang-switch:hover span[aria-hidden] {
    border-bottom-color: currentColor;
  }

  @media (min-width: 48rem) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav lang';
      column-gap: 1.25rem;
      padding-block: 0.85rem;
    }

    .main-nav {
      justify-self: end;
      margin-inline: 0;
    }

    .lang-switch {
      margin-right: 0;
      padding-left: 1.25rem;
      padding-right: 0.25rem;
      border-left: 1px solid var(--border);
      border-radius: 0;
    }
  }
</style>
