---
/** Link that leaves the site: rel="noopener" + visual and screen-reader "external" hint. */
import { t, type Lang } from '../i18n/ui';

interface Props {
  href: string;
  lang: Lang;
  class?: string;
  /** Hide the visual arrow (the sr-only hint is always present). */
  plain?: boolean;
  [attr: string]: unknown;
}

const { href, lang, class: className, plain = false, ...rest } = Astro.props;
---

<a href={href} rel="noopener" class={className} {...rest}
  ><slot />{
    !plain && (
      <svg class="ext-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M4 2h6v6M10 2 2.5 9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    )
  }<span class="sr-only"> {t(lang, 'a11y.external')}</span></a
>
