---
/**
 * Icon set: Lucide (ISC license) via @lucide/astro, plus two brand marks drawn inline
 * (Lucide ships no brand icons). Decorative by default (aria-hidden); pass `label`
 * when the icon is the only content of a control.
 */
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Bot,
  Briefcase,
  Clock,
  CodeXml,
  Cpu,
  FileText,
  FlaskConical,
  FolderGit2,
  Globe,
  GraduationCap,
  Hourglass,
  House,
  Languages,
  Layers,
  Mail,
  MapPin,
  MessageCircle,
  Newspaper,
  Orbit,
  Package,
  Phone,
  ReceiptText,
  Rocket,
  Satellite,
  Server,
  Sparkles,
  Telescope,
  Terminal,
  User,
  Wrench,
  Zap,
  AppWindow,
  Brain,
  CircleCheck,
  Database,
  Eye,
  KeyRound,
  ListChecks,
  Lock,
  Monitor,
  MousePointerClick,
  Play,
  RefreshCw,
  ScanText,
  ShieldCheck,
  Timer,
  UserCheck,
  Search,
  Scale,
} from '@lucide/astro';

const lucide = {
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'arrow-up-right': ArrowUpRight,
  'book-open': BookOpen,
  bot: Bot,
  briefcase: Briefcase,
  clock: Clock,
  code: CodeXml,
  cpu: Cpu,
  'file-text': FileText,
  flask: FlaskConical,
  folder: FolderGit2,
  globe: Globe,
  'graduation-cap': GraduationCap,
  hourglass: Hourglass,
  house: House,
  languages: Languages,
  layers: Layers,
  mail: Mail,
  'map-pin': MapPin,
  message: MessageCircle,
  newspaper: Newspaper,
  orbit: Orbit,
  package: Package,
  phone: Phone,
  receipt: ReceiptText,
  rocket: Rocket,
  satellite: Satellite,
  server: Server,
  sparkles: Sparkles,
  telescope: Telescope,
  terminal: Terminal,
  user: User,
  wrench: Wrench,
  zap: Zap,
  'app-window': AppWindow,
  'brain': Brain,
  'circle-check': CircleCheck,
  'database': Database,
  'eye': Eye,
  'key-round': KeyRound,
  'list-checks': ListChecks,
  'lock': Lock,
  'monitor': Monitor,
  'click': MousePointerClick,
  'play': Play,
  'refresh': RefreshCw,
  'scan-text': ScanText,
  'shield-check': ShieldCheck,
  'timer': Timer,
  'user-check': UserCheck,
  search: Search,
  scale: Scale,
} as const;

export type IconName = keyof typeof lucide | 'github' | 'linkedin';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name. Omit for decorative icons (the default). */
  label?: string;
}

const { name, size = 18, class: className, label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
const Cmp = name === 'github' || name === 'linkedin' ? null : lucide[name];
---

{
  Cmp ? (
    <Cmp size={size} stroke-width={1.75} class:list={['icon', className]} focusable="false" {...a11y} />
  ) : name === 'github' ? (
    <svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" focusable="false" {...a11y}>
      <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  ) : (
    <svg class:list={['icon', className]} width={size} height={size} viewBox="0 0 24 24" fill="currentColor" focusable="false" {...a11y}>
      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.83v1.5h.05c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.67 4.8 6.13v5.42h-4v-4.8c0-1.15-.02-2.62-1.6-2.62-1.6 0-1.84 1.25-1.84 2.54v4.88h-4v-11Z" />
    </svg>
  )
}
