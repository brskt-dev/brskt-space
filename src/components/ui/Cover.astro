---
/**
 * Generated cover art (a little space scene), deterministic per `seed`
 * (the publication slug), so every publication gets its own picture and
 * it never changes between builds. Used until a real `cover:` image exists.
 * Decorative: the card/page already carries the title.
 *
 *   product    → a ringed planet
 *   article    → a constellation
 *   experiment → a nebula with a probe orbit
 */
interface Props {
  seed: string;
  kind?: 'product' | 'article' | 'experiment';
  class?: string;
}

const { seed, kind = 'product', class: className } = Astro.props;

// FNV-1a hash → mulberry32 PRNG: same seed, same scene.
let h = 2166136261;
for (const ch of `${kind}:${seed}`) {
  h ^= ch.codePointAt(0)!;
  h = Math.imul(h, 16777619);
}
let s = h >>> 0;
const rnd = () => {
  s = (s + 0x6d2b79f5) | 0;
  let t = Math.imul(s ^ (s >>> 15), 1 | s);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const pick = <T,>(arr: readonly T[]) => arr[Math.floor(rnd() * arr.length)];
const r1 = (n: number) => Math.round(n * 10) / 10;

const W = 400;
const H = 225;
const id = `cv-${(h >>> 0).toString(36)}`;

const palettes = [
  { a: '#4900c7', b: '#1b0b45', planet: ['#b39dff', '#5b2be0'], ring: '#5eead4' },
  { a: '#3b1fa8', b: '#0f0a2e', planet: ['#5eead4', '#2563eb'], ring: '#b39dff' },
  { a: '#6d28d9', b: '#1a0b33', planet: ['#f0abfc', '#7c3aed'], ring: '#fde68a' },
  { a: '#2e1a87', b: '#0b0820', planet: ['#fde68a', '#f97316'], ring: '#b39dff' },
] as const;
const pal = pick(palettes);

const stars = Array.from({ length: 46 }, () => ({
  x: r1(rnd() * W),
  y: r1(rnd() * H),
  r: r1(0.4 + rnd() * 1.2),
  o: r1(0.35 + rnd() * 0.6),
}));

const planet = { x: r1(W * (0.55 + rnd() * 0.25)), y: r1(H * (0.4 + rnd() * 0.25)), r: r1(34 + rnd() * 22) };
const tilt = r1(-24 + rnd() * 14);
const moon = { a: rnd() * Math.PI * 2, d: planet.r * 1.9, r: r1(5 + rnd() * 4) };

const constellation = Array.from({ length: 6 }, (_, i) => ({
  x: r1(40 + (i / 5) * (W - 80) + (rnd() - 0.5) * 50),
  y: r1(40 + rnd() * (H - 80)),
}));
---

<svg class:list={['cover-art', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={`${id}-bg`} cx="30%" cy="20%" r="95%">
      <stop offset="0" stop-color={pal.a} />
      <stop offset="0.55" stop-color={pal.b} />
      <stop offset="1" stop-color="#07050d" />
    </radialGradient>
    <radialGradient id={`${id}-pl`} cx="35%" cy="30%" r="75%">
      <stop offset="0" stop-color={pal.planet[0]} />
      <stop offset="1" stop-color={pal.planet[1]} />
    </radialGradient>
    <radialGradient id={`${id}-neb`} cx="50%" cy="50%" r="50%">
      <stop offset="0" stop-color={pal.ring} stop-opacity="0.55" />
      <stop offset="1" stop-color={pal.ring} stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width={W} height={H} fill={`url(#${id}-bg)`} />

  <g fill="#fff">
    {stars.map((st) => <circle cx={st.x} cy={st.y} r={st.r} opacity={st.o} />)}
  </g>

  {
    kind === 'product' && (
      <g>
        <circle cx={planet.x} cy={planet.y} r={planet.r} fill={`url(#${id}-pl)`} />
        <ellipse
          cx={planet.x}
          cy={planet.y}
          rx={planet.r * 1.75}
          ry={planet.r * 0.42}
          fill="none"
          stroke={pal.ring}
          stroke-width="3"
          opacity="0.85"
          transform={`rotate(${tilt} ${planet.x} ${planet.y})`}
        />
        <circle
          cx={r1(planet.x + Math.cos(moon.a) * moon.d)}
          cy={r1(planet.y + Math.sin(moon.a) * moon.d * 0.6)}
          r={moon.r}
          fill="#e9e6f0"
          opacity="0.9"
        />
      </g>
    )
  }

  {
    kind === 'article' && (
      <g>
        <polyline
          points={constellation.map((p) => `${p.x},${p.y}`).join(' ')}
          fill="none"
          stroke={pal.ring}
          stroke-width="1.5"
          stroke-dasharray="4 5"
          opacity="0.8"
        />
        {constellation.map((p) => (
          <circle cx={p.x} cy={p.y} r="4" fill="#fff" stroke={pal.ring} stroke-width="2" />
        ))}
      </g>
    )
  }

  {
    kind === 'experiment' && (
      <g>
        <ellipse cx={planet.x} cy={planet.y} rx="150" ry="90" fill={`url(#${id}-neb)`} />
        <ellipse
          cx={planet.x}
          cy={planet.y}
          rx={planet.r * 2.2}
          ry={planet.r * 1.1}
          fill="none"
          stroke="#fff"
          stroke-opacity="0.5"
          stroke-dasharray="3 6"
        />
        <circle cx={r1(planet.x + planet.r * 2.2)} cy={planet.y} r="5" fill={pal.ring} />
      </g>
    )
  }
</svg>

<style>
  .cover-art {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
