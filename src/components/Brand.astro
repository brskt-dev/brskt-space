---
/** "Brskt Space" wordmark with a ringed planet that spins its moon; used by SiteHeader and the 404. */
interface Props {
  href: string;
  'aria-label'?: string;
}

const { href, 'aria-label': ariaLabel } = Astro.props;
---

<a class="brand" href={href} aria-label={ariaLabel}>
  <span class="planet" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="34" height="34" focusable="false">
      <defs>
        <radialGradient id="brand-pl" cx="35%" cy="30%" r="75%">
          <stop offset="0" stop-color="#b39dff" />
          <stop offset="1" stop-color="#4900c7" />
        </radialGradient>
      </defs>
      <circle cx="20" cy="20" r="10" fill="url(#brand-pl)" />
      <ellipse cx="20" cy="20" rx="17" ry="5.5" fill="none" stroke="#5eead4" stroke-width="2" transform="rotate(-22 20 20)" />
    </svg>
    <span class="moon"></span>
  </span>
  <span class="brand-name">brskt<span class="dot">.</span>space</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: var(--tap);
    color: var(--text);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .planet {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    transition: transform 400ms var(--ease-out);
  }

  .brand:hover .planet {
    transform: rotate(-18deg) scale(1.08);
  }

  .moon {
    position: absolute;
    inset: 0;
    animation: spin 8s linear infinite;
  }

  .moon::before {
    content: '';
    position: absolute;
    top: 1px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--sun);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .dot {
    color: var(--mint);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
