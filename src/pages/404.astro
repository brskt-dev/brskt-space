---
/**
 * Single bilingual 404 (GitHub Pages serves <base>/404.html for any missing path),
 * so every URL here is absolute-with-base.
 */
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { htmlLang, pathFor, rootUrl, t } from '../i18n/ui';
import { joinBase } from '../lib/url';

const blocks = [
  { lang: 'pt' as const },
  { lang: 'en' as const },
];
---

<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <BaseHead
      title={`${t('pt', 'notfound.title')} · ${t('en', 'notfound.title')} · Bruno Anhezini`}
      description={`${t('pt', 'notfound.text')} ${t('en', 'notfound.text')}`}
      path={joinBase('404.html').replace(/\/$/, '')}
      locale="pt_BR"
      localeAlternates={['en_US']}
      canonical={false}
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('pt', 'a11y.skip')} / <span lang="en">{t('en', 'a11y.skip')}</span></a>
    <header class="site-header">
      <div class="wrap header-inner">
        <Brand href={rootUrl()} />
      </div>
    </header>
    <main id="main" tabindex="-1" class="wrap nf">
      <div class="nf-inner cols">
        <p class="annot code col-m" aria-hidden="true"><span class="tick">404</span></p>
        <div class="col-main">
          {
            blocks.map(({ lang }, i) => (
              <section class="nf-block" lang={htmlLang[lang]} aria-labelledby={`nf-${lang}`}>
                {i === 0 ? (
                  <h1 id={`nf-${lang}`}>{t(lang, 'notfound.title')}</h1>
                ) : (
                  <h2 id={`nf-${lang}`}>{t(lang, 'notfound.title')}</h2>
                )}
                <p>{t(lang, 'notfound.text')}</p>
                <p>
                  <a class="text-link" href={pathFor(lang, 'home')} hreflang={htmlLang[lang]}>
                    {t(lang, 'notfound.cta')}
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </p>
              </section>
            ))
          }
        </div>
      </div>
    </main>
    <SiteFooter lang="pt" bilingual />
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    padding-block: 0.5rem;
  }

  @media (min-width: 48rem) {
    .header-inner {
      padding-block: 0.85rem;
    }
  }

  main:focus {
    outline: none;
  }

  .nf {
    padding-block: clamp(3rem, 9vw, 6.5rem) 0;
  }

  .nf-inner {
    align-items: baseline;
  }

  .code {
    margin-bottom: 1rem;
    color: var(--accent-2);
  }

  .nf-block {
    max-width: var(--measure);
  }

  .nf-block + .nf-block {
    margin-top: 2.75rem;
    padding-top: 2.75rem;
    border-top: 1px solid var(--border);
  }

  .nf-block h1,
  .nf-block h2 {
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 3.25rem);
    font-weight: 450;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 0.9rem;
  }

  .nf-block p {
    color: var(--muted);
  }

  .nf-block p + p {
    margin-top: 0.4rem;
  }

  @media (min-width: 64rem) {
    .code {
      margin-bottom: 0;
    }
  }
</style>
