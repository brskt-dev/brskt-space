---
/**
 * Single bilingual 404 (GitHub Pages serves <base>/404.html for any missing path),
 * so every URL here is absolute-with-base.
 */
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/ui/Icon.astro';
import { htmlLang, pathFor, rootUrl, t } from '../i18n/ui';
import { joinBase } from '../lib/url';

const blocks = [{ lang: 'pt' as const }, { lang: 'en' as const }];
---

<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <BaseHead
      title={`${t('pt', 'notfound.title')} · ${t('en', 'notfound.title')} · Brskt Space`}
      description={`${t('pt', 'notfound.text')} ${t('en', 'notfound.text')}`}
      path={joinBase('404.html').replace(/\/$/, '')}
      locale="pt_BR"
      localeAlternates={['en_US']}
      canonical={false}
    />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <div class="space" aria-hidden="true"><span class="shooting-star"></span></div>
    <a class="skip-link" href="#main">{t('pt', 'a11y.skip')} / <span lang="en">{t('en', 'a11y.skip')}</span></a>
    <header class="nf-header">
      <div class="wrap">
        <Brand href={rootUrl()} />
      </div>
    </header>
    <main id="main" tabindex="-1" class="wrap nf">
      <div class="lost" aria-hidden="true">
        <span class="big">4<span class="zero"><Icon name="orbit" size={64} /></span>4</span>
        <span class="drifter"><Icon name="rocket" size={30} /></span>
      </div>
      <p class="term mono" aria-hidden="true">
        <span class="p">$</span> cd {'{'}página{'}'}<br /><span class="err">cd: no such file or directory</span>
      </p>
      <div class="blocks">
        {
          blocks.map(({ lang }, i) => (
            <section class="card nf-block" lang={htmlLang[lang]} aria-labelledby={`nf-${lang}`}>
              {i === 0 ? (
                <h1 id={`nf-${lang}`}>{t(lang, 'notfound.title')}</h1>
              ) : (
                <h2 id={`nf-${lang}`}>{t(lang, 'notfound.title')}</h2>
              )}
              <p>{t(lang, 'notfound.text')}</p>
              <p>
                <a class="btn btn-primary" href={pathFor(lang, 'home')} hreflang={htmlLang[lang]}>
                  <Icon name="house" size={16} />
                  {t(lang, 'notfound.cta')}
                </a>
              </p>
            </section>
          ))
        }
      </div>
    </main>
    <SiteFooter lang="pt" bilingual />
  </body>
</html>

<style>
  .nf-header {
    padding-block: 0.6rem;
    border-bottom: 1px solid rgb(43 35 72 / 0.7);
  }

  .nf {
    padding-top: clamp(2.5rem, 8vw, 5rem);
    text-align: center;
  }

  .lost {
    position: relative;
    display: inline-block;
  }

  .big {
    display: inline-flex;
    align-items: center;
    font: 800 clamp(5rem, 3rem + 10vw, 10rem) / 1 var(--font-display);
    letter-spacing: -0.05em;
    background: linear-gradient(120deg, #fff, var(--accent), var(--mint));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .zero {
    display: inline-grid;
    place-items: center;
    margin-inline: 0.05em;
    color: var(--accent);
    animation: spin 10s linear infinite;
  }

  .zero :global(.icon) {
    width: 0.8em;
    height: 0.8em;
  }

  .drifter {
    position: absolute;
    top: 0;
    right: -2.5rem;
    color: var(--mint);
    animation: drift-r 6s ease-in-out infinite;
  }

  .term {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgb(21 16 38 / 0.8);
    font-size: var(--fs-meta);
    text-align: left;
    color: var(--text);
  }

  .p {
    color: var(--mint);
  }

  .err {
    color: #fda4af;
  }

  .blocks {
    display: grid;
    gap: 1rem;
    max-width: 52rem;
    margin: 2rem auto 0;
    text-align: left;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .nf-block {
    gap: 0.75rem;
    padding: 1.5rem;
  }

  .nf-block h1,
  .nf-block h2 {
    font-size: 1.6rem;
  }

  .nf-block p {
    color: var(--muted);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes drift-r {
    50% {
      transform: translate(-10px, 12px) rotate(25deg);
    }
  }
</style>
