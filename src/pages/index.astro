---
/**
 * Root language chooser (/brskt-space/). Works without JS (two links); with JS a tiny
 * inline script redirects by navigator.languages (pt* → /pt/, en* → /en/, default /en/).
 */
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import Icon from '../components/ui/Icon.astro';
import { htmlLang, LANGS, pathFor, rootUrl, t } from '../i18n/ui';
import { BASE } from '../lib/url';

const alternates = [
  ...LANGS.map((l) => ({ hreflang: htmlLang[l], href: pathFor(l, 'home') })),
  { hreflang: 'x-default', href: rootUrl() },
];
const choices = [
  { lang: 'pt' as const, label: 'Português', hint: t('pt', 'chooser.title') },
  { lang: 'en' as const, label: 'English', hint: t('en', 'chooser.title') },
];
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <script is:inline define:vars={{ base: BASE }}>
      (function () {
        try {
          var list = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          var target = 'en/';
          for (var i = 0; i < list.length; i++) {
            var code = String(list[i] || '').toLowerCase();
            if (code.indexOf('pt') === 0) { target = 'pt/'; break; }
            if (code.indexOf('en') === 0) { target = 'en/'; break; }
          }
          location.replace(base + target);
        } catch (e) {}
      })();
    </script>
    <BaseHead
      title="Bruno Anhezini · Brskt Space"
      description="Bruno Anhezini — Desenvolvedor Full Stack / Full Stack Developer. Escolha o idioma · Choose a language."
      path={rootUrl()}
      locale="en_US"
      localeAlternates={['pt_BR']}
      alternates={alternates}
    />
  </head>
  <body>
    <div class="space" aria-hidden="true"><span class="shooting-star"></span></div>
    <main class="chooser wrap">
      <Brand href={rootUrl()} />
      <p class="kicker">
        <span lang="pt-BR">{t('pt', 'chooser.kicker')}</span>
      </p>
      <h1>Bruno Anhezini</h1>
      <p class="hint">
        <span lang="pt-BR">{t('pt', 'chooser.title')}</span>
        <span class="sep" aria-hidden="true">/</span>
        <span>{t('en', 'chooser.title')}</span>
      </p>
      <ul class="choices">
        {
          choices.map((c) => (
            <li>
              <a class="card choice" href={pathFor(c.lang, 'home')} hreflang={htmlLang[c.lang]} lang={htmlLang[c.lang]}>
                <Icon name="globe" size={20} />
                <span class="label">{c.label}</span>
                <span class="chip" aria-hidden="true">{c.lang}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style>
  body {
    justify-content: center;
  }

  .chooser {
    flex: 0 0 auto;
    padding-block: 4rem;
    max-width: calc(36rem + 2 * var(--gutter));
  }

  .kicker {
    margin-top: 2rem;
  }

  h1 {
    font-size: clamp(2.6rem, 1.8rem + 4vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hint {
    margin-top: 0.5rem;
    color: var(--muted);
  }

  .sep {
    margin-inline: 0.4rem;
    color: var(--border-hi);
  }

  .choices {
    list-style: none;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .choice {
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0.75rem 1.1rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 650;
    font-size: 1.15rem;
  }

  .choice :global(.icon) {
    color: var(--mint);
  }

  .choice .chip {
    margin-left: auto;
  }
</style>
